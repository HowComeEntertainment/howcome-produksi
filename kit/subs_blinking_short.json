[{"s": 0.18, "e": 0.84, "t": "Quick question."}, {"s": 1.02, "e": 1.8, "t": "Are you blinking right"}, {"s": 1.84, "e": 2.0, "t": "now?"}, {"s": 2.48, "e": 3.42, "t": "Now you're thinking about"}, {"s": 3.46, "e": 3.54, "t": "it."}, {"s": 3.62, "e": 4.12, "t": "But what if you"}, {"s": 4.18, "e": 5.58, "t": "stopped blinking completely?"}, {"s": 6.04, "e": 6.8, "t": "Even for a minute?"}, {"s": 7.28, "e": 8.02, "t": "And here's the thing."}, {"s": 8.2, "e": 9.5, "t": "You're already blinking way"}, {"s": 9.56, "e": 10.26, "t": "less right now."}, {"s": 10.52, "e": 11.7, "t": "Studies found people blink"}, {"s": 11.76, "e": 12.6, "t": "much less when they"}, {"s": 12.66, "e": 13.56, "t": "stare at screens."}, {"s": 13.74, "e": 14.74, "t": "That's one big reason"}, {"s": 14.78, "e": 15.86, "t": "your eyes feel tired"}, {"s": 15.88, "e": 16.96, "t": "and dry after hours"}, {"s": 17.02, "e": 17.68, "t": "on your phone."}, {"s": 17.86, "e": 18.5, "t": "In one study,"}, {"s": 18.62, "e": 19.82, "t": "people's blink rate dropped"}, {"s": 19.86, "e": 21.08, "t": "from about eighteen times"}, {"s": 21.12, "e": 21.84, "t": "a minute to just"}, {"s": 21.88, "e": 22.76, "t": "a few while working"}, {"s": 22.8, "e": 23.48, "t": "on a computer."}, {"s": 28.084, "e": 28.824, "t": "Plot twist!"}, {"s": 29.024, "e": 30.104, "t": "Blinking isn't just for"}, {"s": 30.143, "e": 30.744, "t": "your eyes."}, {"s": 30.924, "e": 31.584, "t": "In one study,"}, {"s": 31.724, "e": 32.844, "t": "scientists saw that right"}, {"s": 32.904, "e": 33.784, "t": "after people blink,"}, {"s": 33.924, "e": 35.144, "t": "the brain's resting network"}, {"s": 35.224, "e": 35.884, "t": "lights up for a"}, {"s": 35.924, "e": 36.324, "t": "moment."}, {"s": 36.524, "e": 37.424, "t": "Every blink might be"}, {"s": 37.464, "e": 38.764, "t": "a tiny mental break."}, {"s": 39.024, "e": 39.704, "t": "So if you've been"}, {"s": 39.764, "e": 40.564, "t": "staring at your phone,"}, {"s": 40.664, "e": 42.284, "t": "try the twenty-twenty-twenty rule."}, {"s": 42.484, "e": 43.284, "t": "Every twenty minutes,"}, {"s": 43.384, "e": 44.264, "t": "look at something twenty"}, {"s": 44.384, "e": 45.224, "t": "feet away for twenty"}, {"s": 45.344, "e": 45.844, "t": "seconds."}, {"s": 46.265, "e": 46.984, "t": "Did you blink while"}, {"s": 47.024, "e": 47.604, "t": "watching this?"}, {"s": 47.864, "e": 48.824, "t": "Team blink or team"}, {"s": 48.984, "e": 49.304, "t": "stare?"}, {"s": 49.464, "e": 49.884, "t": "Tell me in the"}, {"s": 49.924, "e": 50.344, "t": "comments,"}, {"s": 50.424, "e": 51.504, "t": "and subscribe for more"}, {"s": 51.544, "e": 52.164, "t": "HowCome!"}]