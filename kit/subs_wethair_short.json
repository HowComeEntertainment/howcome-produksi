[{"s": 0.14, "e": 0.9, "t": "Late shower,"}, {"s": 1.14, "e": 1.68, "t": "wet hair,"}, {"s": 1.88, "e": 2.56, "t": "straight to bed."}, {"s": 2.72, "e": 3.44, "t": "Your mom says you'll"}, {"s": 3.48, "e": 4.14, "t": "catch a cold."}, {"s": 4.36, "e": 4.94, "t": "So what if you"}, {"s": 5.04, "e": 5.92, "t": "slept with wet hair"}, {"s": 5.96, "e": 6.5, "t": "every night?"}, {"s": 7.12, "e": 7.76, "t": "Sound familiar?"}, {"s": 8.02, "e": 8.66, "t": "Your hair takes a"}, {"s": 8.7, "e": 9.26, "t": "hit too."}, {"s": 9.46, "e": 10.62, "t": "Wet hair is weaker"}, {"s": 10.64, "e": 11.86, "t": "and stretchier than dry"}, {"s": 11.94, "e": 12.18, "t": "hair."}, {"s": 12.36, "e": 12.94, "t": "Rubbing it on a"}, {"s": 12.98, "e": 13.96, "t": "pillow all night can"}, {"s": 14.0, "e": 14.9, "t": "lead to more frizz"}, {"s": 14.92, "e": 15.64, "t": "and breakage."}, {"s": 15.82, "e": 16.64, "t": "So the damage is"}, {"s": 16.72, "e": 17.02, "t": "real,"}, {"s": 17.18, "e": 18.1, "t": "just not the cold."}, {"s": 18.26, "e": 19.3, "t": "Hair stylists say it's"}, {"s": 19.34, "e": 20.12, "t": "better to dry your"}, {"s": 20.16, "e": 21.26, "t": "hair at least partly"}, {"s": 21.28, "e": 21.98, "t": "before bed,"}, {"s": 22.12, "e": 22.8, "t": "or use a soft"}, {"s": 22.88, "e": 23.88, "t": "pillowcase and a loose"}, {"s": 23.96, "e": 24.38, "t": "style."}, {"s": 29.068, "e": 29.928, "t": "Plot twist!"}, {"s": 30.048, "e": 31.128, "t": "Getting chilly might matter"}, {"s": 31.168, "e": 31.528, "t": "a little."}, {"s": 31.708, "e": 32.388, "t": "In one study,"}, {"s": 32.528, "e": 33.308, "t": "people who sat with"}, {"s": 33.348, "e": 34.168, "t": "their feet in cold"}, {"s": 34.248, "e": 35.408, "t": "water were more likely"}, {"s": 35.448, "e": 36.708, "t": "to report cold symptoms"}, {"s": 36.848, "e": 37.548, "t": "days later."}, {"s": 37.748, "e": 39.108, "t": "Scientists think chilling might"}, {"s": 39.128, "e": 39.968, "t": "wake up a virus"}, {"s": 40.008, "e": 40.868,