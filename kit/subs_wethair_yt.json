[{"s": 0.14, "e": 0.9, "t": "Late shower,"}, {"s": 1.14, "e": 1.68, "t": "wet hair,"}, {"s": 1.88, "e": 2.56, "t": "straight to bed."}, {"s": 2.72, "e": 3.44, "t": "Your mom says you'll"}, {"s": 3.48, "e": 4.14, "t": "catch a cold."}, {"s": 4.36, "e": 4.94, "t": "So what if you"}, {"s": 5.04, "e": 5.92, "t": "slept with wet hair"}, {"s": 5.96, "e": 6.5, "t": "every night?"}, {"s": 7.12, "e": 7.76, "t": "Sound familiar?"}, {"s": 17.484, "e": 17.824, "t": "First,"}, {"s": 18.024, "e": 18.784, "t": "the cold myth."}, {"s": 18.964, "e": 19.984, "t": "Colds are caused by"}, {"s": 20.024, "e": 20.664, "t": "viruses,"}, {"s": 20.864, "e": 21.804, "t": "not by wet hair."}, {"s": 21.964, "e": 22.644, "t": "No virus,"}, {"s": 22.864, "e": 23.444, "t": "no cold."}, {"s": 23.644, "e": 24.804, "t": "So wet hair alone"}, {"s": 24.864, "e": 25.984, "t": "can't magically give you"}, {"s": 26.024, "e": 26.244, "t": "one."}, {"s": 26.364, "e": 27.164, "t": "You catch a cold"}, {"s": 27.184, "e": 28.044, "t": "when a virus gets"}, {"s": 28.084, "e": 28.864, "t": "into your nose or"}, {"s": 28.904, "e": 29.244, "t": "mouth,"}, {"s": 29.444, "e": 30.664, "t": "usually from other people"}, {"s": 30.704, "e": 31.764, "t": "or things they touched."}, {"s": 31.904, "e": 32.964, "t": "That's why colds spread"}, {"s": 33.004, "e": 34.044, "t": "so easily at school"}, {"s": 34.064, "e": 34.604, "t": "and work."}, {"s": 44.168, "e": 45.088, "t": "But your pillow is"}, {"s": 45.148, "e": 45.928, "t": "another story."}, {"s": 46.108, "e": 46.928, "t": "A damp pillow,"}, {"s": 47.088, "e": 47.888, "t": "night after night,"}, {"s": 48.028, "e": 49.068, "t": "is a cozy home"}, {"s": 49.108, "e": 49.808, "t": "for fungi."}, {"s": 50.028, "e": 51.287, "t": "One study tested used"}, {"s": 51.388, "e": 52.588, "t": "pillows and found several"}, {"s": 52.688, "e": 53.768, "t": "kinds of fungi living"}, {"s": 53.808, "e": 54.788, "t": "inside each one."}, {"s": 55.428, "e": 55.828, "t": "Warm,"}, {"s": 56.068, "e": 56.388, "t": "damp,"}, {"s": 56.468, "e": 57.848, "t": "and dark is exactly"}, {"s": 57.868, "e": 58.588, "t": "what they love."}, {"s": 58.748, "e": 60.188, "t": "Fungi can trigger sneezing"}, {"s": 60.208, "e": 61.328, "t": "and stuffy noses for"}, {"s": 61.368, "e": 62.508, "t": "people with allergies or"}, {"s": 62.608, "e": 63.028, "t": "asthma."}, {"s": 63.188, "e": 64.708, "t": "Washing your pillowcase often"}, {"s": 64.728, "e": 65.488, "t": "and letting your pillow"}, {"s": 65.588, "e": 66.448, "t": "dry out helps a"}, {"s": 66.508, "e": 66.908, "t": "lot."}, {"s": 67.028, "e": 67.808, "t": "And your scalp can"}, {"s": 67.848, "e": 68.588, "t": "get itchy if it"}, {"s": 68.668, "e": 70.008, "t": "stays damp for hours."}, {"s": 79.652, "e": 80.292, "t": "Your hair takes a"}, {"s": 80.332, "e": 80.892, "t": "hit too."}, {"s": 81.092, "e": 82.252, "t": "Wet hair is weaker"}, {"s": 82.272, "e": 83.492, "t": "and stretchier than dry"}, {"s": 83.572, "e": 83.812, "t": "hair."}, {"s": 83.992, "e": 84.572, "t": "Rubbing it on a"}, {"s": 84.612, "e": 85.592, "t": "pillow all night can"}, {"s": 85.632, "e": 86.532, "t": "lead to more frizz"}, {"s": 86.552, "e": 87.272, "t": "and breakage."}, {"s": 87.452, "e": 88.272, "t": "So the damage is"}, {"s": 88.352, "e": 88.652, "t": "real,"}, {"s": 88.812, "e": 89.732, "t": "just not the cold."}, {"s": 89.892, "e": 90.932, "t": "Hair stylists say it's"}, {"s": 90.972, "e": 91.752, "t": "better to dry your"}, {"s": 91.792, "e": 92.892, "t": "hair at least partly"}, {"s": 92.912, "e": 93.612, "t": "before bed,"}, {"s": 93.752, "e": 94.432, "t": "or use a soft"}, {"s": 94.512, "e": 95.512, "t": "pillowcase and a loose"}, {"s": 95.592, "e": 96.012, "t": "style."}, {"s": 105.636, "e": 106.496, "t": "Plot twist!"}, {"s": 106.616, "e": 107.696, "t": "Getting chilly might matter"}, {"s": 107.736, "e": 108.096, "t": "a little."}, {"s": 108.276, "e": 108.956, "t": "In one study,"}, {"s": 109.096, "e": 109.876, "t": "people who sat with"}, {"s": 109.916, "e": 110.736, "t": "their feet in cold"}, {"s": 110.816, "e": 111.976, "t": "water were more likely"}, {"s": 112.016, "e": 113.276, "t": "to report cold symptoms"}, {"s": 113.416, "e": 114.116, "t": "days later."}, {"s": 114.316, "e": 115.676, "t": "Scientists think chilling might"}, {"s": 115.696, "e": 116.536, "t": "wake up a virus"}, {"s": 116.576, "e": 117.436, "t": "that's already there."}, {"s": 117.636, "e": 118.236, "t": "So it's not the"}, {"s": 118.276, "e": 119.356, "t": "wet hair itself."}, {"s": 119.476, "e": 120.616, "t": "But feeling cold might"}, {"s": 120.636, "e": 121.696, "t": "give a hiding virus"}, {"s": 121.756, "e": 122.936, "t": "a small head start."}, {"s": 132.82, "e": 133.02, "t": "So,"}, {"s": 133.22, "e": 134.24, "t": "team wet hair or"}, {"s": 134.38, "e": 135.24, "t": "team blow dry?"}, {"s": 135.42, "e": 135.82, "t": "Tell me in the"}, {"s": 135.86, "e": 136.26, "t": "comments,"}, {"s": 136.3, "e": 137.36, "t": "and subscribe for more"}, {"s": 137.4, "e": 137.96, "t": "HowCome!"}]