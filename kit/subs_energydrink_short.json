[{"s": 0.18, "e": 0.78, "t": "One can in the"}, {"s": 0.84, "e": 1.18, "t": "morning,"}, {"s": 1.44, "e": 2.26, "t": "one after lunch,"}, {"s": 2.46, "e": 3.42, "t": "one before the gym."}, {"s": 3.72, "e": 4.42, "t": "What if you drank"}, {"s": 4.46, "e": 5.86, "t": "an energy drink every"}, {"s": 6.06, "e": 6.78, "t": "single day?"}, {"s": 7.02, "e": 7.92, "t": "A big can can"}, {"s": 7.96, "e": 9.02, "t": "pack around one hundred"}, {"s": 9.18, "e": 10.74, "t": "sixty milligrams of caffeine,"}, {"s": 10.86, "e": 11.9, "t": "and some have over"}, {"s": 11.94, "e": 13.34, "t": "fifty grams of sugar."}, {"s": 13.46, "e": 14.48, "t": "That's more sugar than"}, {"s": 14.52, "e": 15.56, "t": "many adults should have"}, {"s": 15.58, "e": 16.36, "t": "in a whole day."}, {"s": 16.5, "e": 17.06, "t": "And if you drink"}, {"s": 17.1, "e": 18.06, "t": "it in the afternoon?"}, {"s": 18.22, "e": 19.4, "t": "That caffeine can still"}, {"s": 19.56, "e": 20.56, "t": "steal sleep at night."}, {"s": 20.86, "e": 21.54, "t": "Here's the trick."}, {"s": 21.68, "e": 23.2, "t": "Caffeine blocks adenosine,"}, {"s": 23.36, "e": 24.7, "t": "your brain's sleepy signal."}, {"s": 24.8, "e": 26.32, "t": "But adenosine keeps piling"}, {"s": 26.46, "e": 26.64, "t": "up."}, {"s": 26.74, "e": 27.76, "t": "When the caffeine wears"}, {"s": 27.84, "e": 28.06, "t": "off,"}, {"s": 28.18, "e": 28.86, "t": "it all hits at"}, {"s": 28.98, "e": 29.28, "t": "once."}, {"s": 29.44, "e": 30.36, "t": "That's the crash."}, {"s": 30.58, "e": 31.44, "t": "In one study,"}, {"s": 31.58, "e": 32.78, "t": "healthy young adults drank"}, {"s": 32.82, "e": 34.0, "t": "a single energy drink,"}, {"s": 34.12, "e": 35.02, "t": "and their blood pressure"}, {"s": 35.18, "e": 36.08, "t": "jumped more than with"}, {"s": 36.12, "e": 37.04, "t": "caffeine alone."}, {"s": 37.24, "e": 38.46, "t": "Some even showed changes"}, {"s": 38.5, "e": 39.38, "t": "in their heart rhythm."}, {"s": 39.996, "e": 40.776, "t": "Plot twist!"}, {"s": 40.936, "e": 41.976, "t": "Your body adapts."}, {"s": 42.156, "e": 43.236, "t": "Drink one every day,"}, {"s": 43.356, "e": 44.176, "t": "and you start needing"}, {"s": 44.216, "e": 44.876, "t": "it just to feel"}, {"s": 44.996, "e": 45.416, "t": "normal."}, {"s": 45.616, "e": 46.196, "t": "Skip a day?"}, {"s": 46.396, "e": 46.796, "t": "Headache,"}, {"s": 46.996, "e": 47.356, "t": "fog,"}, {"s": 47.496, "e": 48.116, "t": "bad mood."}, {"s": 48.256, "e": 49.556, "t": "That's caffeine withdrawal."}, {"s": 49.856, "e": 51.076, "t": "Team energy drink or"}, {"s": 51.196, "e": 51.836, "t": "team water?"}, {"s": 51.976, "e": 52.436, "t": "Tell me in the"}, {"s": 52.476, "e": 52.896, "t": "comments,"}, {"s": 52.956, "e": 53.956, "t": "and subscribe for more"}, {"s": 53.996, "e": 54.616, "t": "HowCome!"}]