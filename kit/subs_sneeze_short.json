[{"s": 0.22, "e": 0.58, "t": "Ahh..."}, {"s": 1.12, "e": 1.28, "t": "ahh..."}, {"s": 1.46, "e": 2.24, "t": "You feel a sneeze"}, {"s": 2.34, "e": 2.64, "t": "coming,"}, {"s": 2.86, "e": 3.3, "t": "and you're in a"}, {"s": 3.38, "e": 4.16, "t": "quiet room."}, {"s": 4.32, "e": 4.96, "t": "What if you held"}, {"s": 5.04, "e": 6.64, "t": "in every single sneeze?"}, {"s": 6.78, "e": 7.48, "t": "You hold it in."}, {"s": 7.87, "e": 9.15, "t": "Doctors reported a real"}, {"s": 9.27, "e": 9.71, "t": "case."}, {"s": 9.83, "e": 10.49, "t": "A man held in"}, {"s": 10.53, "e": 11.51, "t": "a sneeze by pinching"}, {"s": 11.53, "e": 12.51, "t": "his nose and closing"}, {"s": 12.53, "e": 12.99, "t": "his mouth,"}, {"s": 13.07, "e": 13.73, "t": "and it tore the"}, {"s": 13.77, "e": 14.65, "t": "back of his throat."}, {"s": 14.75, "e": 15.27, "t": "He ended up in"}, {"s": 15.31, "e": 15.91, "t": "the hospital,"}, {"s": 16.05, "e": 16.93, "t": "eating through a tube"}, {"s": 16.95, "e": 17.67, "t": "for days."}, {"s": 17.81, "e": 18.91, "t": "Doctors said cases like"}, {"s": 18.95, "e": 20.09, "t": "this are very rare,"}, {"s": 20.17, "e": 20.79, "t": "but it shows how"}, {"s": 20.81, "e": 21.77, "t": "much force a sneeze"}, {"s": 21.81, "e": 22.57, "t": "really packs."}, {"s": 31.0, "e": 31.72, "t": "Plot twist!"}, {"s": 31.88, "e": 33.06, "t": "You almost never sneeze"}, {"s": 33.1, "e": 33.72, "t": "in your sleep."}, {"s": 33.84, "e": 34.44, "t": "When you're asleep,"}, {"s": 34.58, "e": 35.48, "t": "the nerves that trigger"}, {"s": 35.52, "e": 36.7, "t": "a sneeze mostly shut"}, {"s": 36.74, "e": 37.1, "t": "down."}, {"s": 37.28, "e": 38.26, "t": "So your body saves"}, {"s": 38.34, "e": 39.22, "t": "all its sneezes for"}, {"s": 39.24, "e": 40.0, "t": "when you're awake."}, {"s": 40.14, "e": 40.6, "t": "And no,"}, {"s": 40.64, "e": 41.58, "t": "your eyes can't pop"}, {"s": 41.66, "e": 42.3, "t": "out if you sneeze"}, {"s": 42.34, "e": 43.0, "t": "with them open."}, {"s": 43.16, "e": 43.88, "t": "That's a myth."}, {"s": 44.08, "e": 44.26, "t": "So,"}, {"s": 44.38, "e": 45.08, "t": "are you a loud"}, {"s": 45.18, "e": 46.16, "t": "sneezer or a tiny"}, {"s": 46.28, "e": 46.64, "t": "sneezer?"}, {"s": 46.82, "e": 47.24, "t": "Tell me in the"}, {"s": 47.28, "e": 47.7, "t": "comments,"}, {"s": 47.74, "e": 48.74, "t": "and subscribe for more"}, {"s": 48.78, "e": 49.38, "t": "HowCome!"}]