[{"s": 0.12, "e": 0.9, "t": "No toothbrush."}, {"s": 1.3, "e": 2.3, "t": "No toothpaste."}, {"s": 2.78, "e": 3.4, "t": "Forever."}, {"s": 3.7, "e": 4.36, "t": "What if you never"}, {"s": 4.46, "e": 5.62, "t": "brushed your teeth again?"}, {"s": 5.84, "e": 6.76, "t": "Not even once?"}, {"s": 24.352, "e": 25.191, "t": "Your mouth is home"}, {"s": 25.232, "e": 26.232, "t": "to hundreds of kinds"}, {"s": 26.272, "e": 26.972, "t": "of bacteria."}, {"s": 27.152, "e": 28.132, "t": "Most are harmless,"}, {"s": 28.272, "e": 29.572, "t": "but some love sugar"}, {"s": 29.732, "e": 30.432, "t": "just as much as"}, {"s": 30.492, "e": 30.832, "t": "you do."}, {"s": 30.972, "e": 31.852, "t": "And every time you"}, {"s": 31.912, "e": 32.052, "t": "eat,"}, {"s": 32.292, "e": 33.292, "t": "you feed them too."}, {"s": 50.844, "e": 51.804, "t": "Within hours,"}, {"s": 51.884, "e": 52.744, "t": "they build a sticky"}, {"s": 52.864, "e": 53.904, "t": "film called plaque."}, {"s": 54.124, "e": 54.644, "t": "Leave it for a"}, {"s": 54.684, "e": 55.164, "t": "few days,"}, {"s": 55.264, "e": 56.204, "t": "and it hardens into"}, {"s": 56.264, "e": 56.684, "t": "tartar,"}, {"s": 56.964, "e": 57.744, "t": "so rough that a"}, {"s": 57.804, "e": 58.944, "t": "toothbrush can't remove it"}, {"s": 59.004, "e": 59.464, "t": "anymore."}, {"s": 60.044, "e": 60.704, "t": "And your breath?"}, {"s": 61.064, "e": 61.504, "t": "Yikes."}, {"s": 79.136, "e": 80.296, "t": "In a classic experiment,"}, {"s": 80.436, "e": 82.096, "t": "healthy volunteers stopped cleaning"}, {"s": 82.136, "e": 82.656, "t": "their teeth."}, {"s": 82.796, "e": 83.516, "t": "Within two to three"}, {"s": 83.615, "e": 83.895, "t": "weeks,"}, {"s": 84.096, "e": 85.176, "t": "every single one got"}, {"s": 85.256, "e": 85.676, "t": "swollen,"}, {"s": 85.816, "e": 86.696, "t": "bleeding gums."}, {"s": 86.836, "e": 87.716, "t": "When they started brushing"}, {"s": 87.776, "e": 88.056, "t": "again,"}, {"s": 88.216, "e": 88.756, "t": "it healed."}, {"s": 106.268, "e": 107.008, "t": "Plot twist!"}, {"s": 107.188, "e": 109.208, "t": "Ancient hunter-gatherers never brushed,"}, {"s": 109.308, "e": 110.108, "t": "yet they had far"}, {"s": 110.228, "e": 111.308, "t": "fewer cavities than we"}, {"s": 111.348, "e": 111.568, "t": "do."}, {"s": 111.728, "e": 112.308, "t": "The difference?"}, {"s": 112.928, "e": 113.608, "t": "They didn't eat our"}, {"s": 113.668, "e": 114.888, "t": "sugar and soft processed"}, {"s": 114.968, "e": 115.328, "t": "food."}, {"s": 132.92, "e": 133.1, "t": "So,"}, {"s": 133.24, "e": 133.9, "t": "how many times a"}, {"s": 133.94, "e": 134.78, "t": "day do you really"}, {"s": 134.8, "e": 135.18, "t": "brush?"}, {"s": 135.34, "e": 135.74, "t": "Tell me in the"}, {"s": 135.78, "e": 136.2, "t": "comments,"}, {"s": 136.3, "e": 137.34, "t": "and subscribe for more"}, {"s": 137.38, "e": 137.94, "t": "HowCome!"}]