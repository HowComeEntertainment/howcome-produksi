[{"s": 0.14, "e": 0.46, "t": "Pop!"}, {"s": 0.76, "e": 1.22, "t": "Crack!"}, {"s": 1.36, "e": 2.2, "t": "You probably did it"}, {"s": 2.24, "e": 3.5, "t": "today without even noticing."}, {"s": 3.6, "e": 4.26, "t": "What if you cracked"}, {"s": 4.3, "e": 5.48, "t": "your knuckles every single"}, {"s": 5.6, "e": 5.86, "t": "day?"}, {"s": 5.96, "e": 6.7, "t": "Would you really get"}, {"s": 6.74, "e": 7.3, "t": "arthritis?"}, {"s": 7.54, "e": 8.38, "t": "Up to half of"}, {"s": 8.42, "e": 9.66, "t": "people crack their knuckles,"}, {"s": 9.84, "e": 10.74, "t": "often when they're bored"}, {"s": 10.76, "e": 11.42, "t": "or stressed."}, {"s": 11.46, "e": 12.24, "t": "And for years,"}, {"s": 12.44, "e": 13.28, "t": "nobody even knew where"}, {"s": 13.32, "e": 14.44, "t": "that popping sound came"}, {"s": 14.46, "e": 14.7, "t": "from."}, {"s": 15.16, "e": 16.14, "t": "Your knuckle joints are"}, {"s": 16.18, "e": 17.12, "t": "filled with a slippery"}, {"s": 17.28, "e": 17.72, "t": "fluid."}, {"s": 17.84, "e": 18.4, "t": "When you pull the"}, {"s": 18.44, "e": 18.98, "t": "joint apart,"}, {"s": 19.08, "e": 20.0, "t": "the pressure drops,"}, {"s": 20.06, "e": 20.84, "t": "and a gas bubble"}, {"s": 20.96, "e": 21.92, "t": "suddenly forms."}, {"s": 22.1, "e": 23.36, "t": "Scientists filmed it inside"}, {"s": 23.4, "e": 24.18, "t": "an MRI."}, {"s": 24.36, "e": 25.16, "t": "That's the pop!"}, {"s": 25.7, "e": 26.44, "t": "And that's why you"}, {"s": 26.48, "e": 27.36, "t": "can't crack the same"}, {"s": 27.38, "e": 28.56, "t": "knuckle again right away."}, {"s": 28.68, "e": 29.62, "t": "The gas needs about"}, {"s": 29.66, "e": 30.88, "t": "twenty minutes to dissolve"}, {"s": 30.9, "e": 31.92, "t": "back into the fluid."}, {"s": 32.06, "e": 33.44, "t": "Your joint literally needs"}, {"s": 33.5, "e": 34.32, "t": "a recharge."}, {"s": 36.876, "e": 37.776, "t": "Plot twist!"}, {"s": 37.956, "e": 38.976, "t": "One doctor cracked the"}, {"s": 38.996, "e": 39.996, "t": "knuckles on only his"}, {"s": 40.076, "e": 40.536, "t": "left hand,"}, {"s": 40.656, "e": 41.196, "t": "twice a day,"}, {"s": 41.296, "e": 42.356, "t": "for sixty years."}, {"s": 42.456, "e": 43.036, "t": "His result?"}, {"s": 43.256, "e": 44.356, "t": "No arthritis in either"}, {"s": 44.396, "e": 44.776, "t": "hand."}, {"s": 44.896, "e": 45.656, "t": "He even won an"}, {"s": 45.716, "e": 46.796, "t": "Ig Nobel Prize."}, {"s": 47.436, "e": 47.676, "t": "So,"}, {"s": 47.796, "e": 48.476, "t": "are you a knuckle"}, {"s": 48.576, "e": 48.936, "t": "cracker?"}, {"s": 49.176, "e": 50.116, "t": "Team crack or team"}, {"s": 50.196, "e": 50.796, "t": "no crack?"}, {"s": 50.936, "e": 51.356, "t": "Tell me in the"}, {"s": 51.396, "e": 51.836, "t": "comments,"}, {"s": 51.896, "e": 52.956, "t": "and subscribe for more"}, {"s": 52.996, "e": 53.536, "t": "HowCome!"}]