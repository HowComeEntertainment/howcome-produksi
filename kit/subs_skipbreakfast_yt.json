[{"s": 0.12, "e": 0.66, "t": "Parents,"}, {"s": 0.92, "e": 1.56, "t": "teachers,"}, {"s": 1.7, "e": 2.66, "t": "cereal boxes..."}, {"s": 2.74, "e": 3.74, "t": "they all say breakfast"}, {"s": 3.78, "e": 4.82, "t": "is the most important"}, {"s": 4.86, "e": 5.6, "t": "meal of the day."}, {"s": 5.7, "e": 6.28, "t": "But what if you"}, {"s": 6.4, "e": 7.32, "t": "skipped it for thirty"}, {"s": 7.44, "e": 7.9, "t": "days?"}, {"s": 21.187, "e": 21.747, "t": "Fun fact:"}, {"s": 21.887, "e": 22.827, "t": "that famous line got"}, {"s": 22.867, "e": 23.787, "t": "a huge push from"}, {"s": 23.827, "e": 24.927, "t": "cereal companies over a"}, {"s": 24.987, "e": 25.907, "t": "hundred years ago."}, {"s": 26.327, "e": 26.507, "t": "Yep."}, {"s": 26.687, "e": 27.927, "t": "People selling breakfast said"}, {"s": 28.027, "e": 28.987, "t": "breakfast matters."}, {"s": 42.314, "e": 43.634, "t": "Week one is rough."}, {"s": 43.754, "e": 44.634, "t": "Your hunger hormone,"}, {"s": 44.714, "e": 45.094, "t": "ghrelin,"}, {"s": 45.234, "e": 46.114, "t": "follows your schedule,"}, {"s": 46.254, "e": 47.074, "t": "so your stomach still"}, {"s": 47.094, "e": 48.274, "t": "growls at breakfast time."}, {"s": 48.994, "e": 49.534, "t": "Cranky,"}, {"s": 49.774, "e": 50.254, "t": "foggy,"}, {"s": 50.414, "e": 51.434, "t": "dreaming of donuts."}, {"s": 51.534, "e": 52.234, "t": "But after a couple"}, {"s": 52.274, "e": 52.674, "t": "of weeks,"}, {"s": 52.754, "e": 53.454, "t": "for many people,"}, {"s": 53.594, "e": 54.874, "t": "that morning hunger fades."}, {"s": 68.182, "e": 70.161, "t": "\"Breakfast kickstarts your metabolism\"?"}, {"s": 70.601, "e": 71.8, "t": "When researchers tested it,"}, {"s": 71.921, "e": 73.061, "t": "breakfast didn't change how"}, {"s": 73.081, "e": 74.261, "t": "many calories people burned"}, {"s": 74.301, "e": 74.941, "t": "at rest."}, {"s": 88.188, "e": 89.088, "t": "Here's the shock."}, {"s": 89.228, "e": 90.608, "t": "A big BMJ review"}, {"s": 90.648, "e": 92.128, "t": "found breakfast eaters actually"}, {"s": 92.188, "e": 93.008, "t": "ate about two hundred"}, {"s": 93.208, "e": 94.308, "t": "sixty more calories a"}, {"s": 94.348, "e": 94.648, "t": "day,"}, {"s": 94.748, "e": 95.848, "t": "and breakfast didn't help"}, {"s": 95.888, "e": 96.748, "t": "people lose weight."}, {"s": 110.035, "e": 110.855, "t": "Plot twist!"}, {"s": 111.035, "e": 112.235, "t": "Skipping only works if"}, {"s": 112.295, "e": 113.215, "t": "lunch isn't a junk"}, {"s": 113.235, "e": 113.795, "t": "food party."}, {"s": 113.935, "e": 114.515, "t": "And kids,"}, {"s": 114.655, "e": 114.995, "t": "teens,"}, {"s": 115.035, "e": 116.095, "t": "and people with diabetes"}, {"s": 116.135, "e": 117.215, "t": "on medication should be"}, {"s": 117.255, "e": 117.695, "t": "careful."}, {"s": 117.835, "e": 118.875, "t": "What really matters is"}, {"s": 118.915, "e": 119.615, "t": "what you eat all"}, {"s": 119.655, "e": 119.975, "t": "day."}, {"s": 133.322, "e": 133.422, "t": "So,"}, {"s": 133.842, "e": 134.982, "t": "team breakfast or team"}, {"s": 135.082, "e": 135.342, "t": "skip?"}, {"s": 135.502, "e": 135.942, "t": "Tell me in the"}, {"s": 135.982, "e": 136.402, "t": "comments,"}, {"s": 136.462, "e": 137.402, "t": "and subscribe for more"}, {"s": 137.442, "e": 137.962, "t": "HowCome!"}]