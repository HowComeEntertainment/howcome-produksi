[{"s": 1.06, "e": 1.6, "t": "Yawn."}, {"s": 2.5, "e": 3.26, "t": "Did you just yawn"}, {"s": 3.36, "e": 3.58, "t": "too?"}, {"s": 3.8, "e": 4.94, "t": "It's so contagious."}, {"s": 5.2, "e": 5.74, "t": "But what if you"}, {"s": 5.76, "e": 7.26, "t": "could never yawn again?"}, {"s": 7.64, "e": 8.4, "t": "I bet you're fighting"}, {"s": 8.48, "e": 9.14, "t": "one right now."}, {"s": 19.14, "e": 20.06, "t": "Everyone yawns."}, {"s": 20.24, "e": 21.64, "t": "Babies yawn even before"}, {"s": 21.66, "e": 22.28, "t": "they're born."}, {"s": 22.4, "e": 23.36, "t": "And just reading or"}, {"s": 23.42, "e": 24.62, "t": "hearing about yawning can"}, {"s": 24.66, "e": 25.32, "t": "make you do it."}, {"s": 25.56, "e": 26.48, "t": "Some studies found that"}, {"s": 26.52, "e": 27.56, "t": "around half of adults"}, {"s": 27.64, "e": 28.4, "t": "yawn when they see"}, {"s": 28.44, "e": 29.3, "t": "someone else yawn."}, {"s": 29.5, "e": 30.94, "t": "Even unborn babies yawn"}, {"s": 30.98, "e": 31.58, "t": "in the womb."}, {"s": 31.72, "e": 33.0, "t": "And many animals yawn"}, {"s": 33.04, "e": 33.32, "t": "too,"}, {"s": 33.44, "e": 34.5, "t": "from cats and dogs"}, {"s": 34.54, "e": 35.58, "t": "to fish and birds."}, {"s": 35.78, "e": 36.84, "t": "Yawning is clearly an"}, {"s": 36.92, "e": 37.14, "t": "old,"}, {"s": 37.28, "e": 38.32, "t": "built-in behavior."}, {"s": 48.42, "e": 49.2, "t": "So why do we"}, {"s": 49.24, "e": 49.98, "t": "yawn at all?"}, {"s": 50.18, "e": 51.1, "t": "An old idea was"}, {"s": 51.16, "e": 52.16, "t": "that yawning brings in"}, {"s": 52.22, "e": 53.04, "t": "more oxygen."}, {"s": 53.14, "e": 54.38, "t": "But when scientists tested"}, {"s": 54.44, "e": 54.52, "t": "it,"}, {"s": 54.74, "e": 56.16, "t": "extra oxygen didn't change"}, {"s": 56.18, "e": 57.54, "t": "how often people yawned."}, {"s": 57.7, "e": 59.1, "t": "So that explanation doesn't"}, {"s": 59.12, "e": 59.94, "t": "really hold up."}, {"s": 60.04, "e": 61.1, "t": "Another idea is that"}, {"s": 61.14, "e": 62.12, "t": "yawning just means you're"}, {"s": 62.14, "e": 63.22, "t": "bored or tired."}, {"s": 63.38, "e": 64.3, "t": "That's partly true."}, {"s": 64.42, "e": 65.42, "t": "We yawn more before"}, {"s": 65.46, "e": 66.48, "t": "sleep and after waking"}, {"s": 66.6, "e": 66.72, "t": "up."}, {"s": 66.88, "e": 67.66, "t": "But that still doesn't"}, {"s": 67.7, "e": 69.14, "t": "explain why yawns spread"}, {"s": 69.18, "e": 70.26, "t": "from person to person."}, {"s": 80.14, "e": 81.04, "t": "A newer idea is"}, {"s": 81.08, "e": 82.28, "t": "that yawning helps cool"}, {"s": 82.34, "e": 82.9, "t": "your brain."}, {"s": 83.1, "e": 84.0, "t": "That big gulp of"}, {"s": 84.1, "e": 84.82, "t": "air and the stretch"}, {"s": 84.88, "e": 85.6, "t": "of your jaw can"}, {"s": 85.62, "e": 86.72, "t": "bring in cooler blood."}, {"s": 86.88, "e": 87.4, "t": "In studies,"}, {"s": 87.5, "e": 88.52, "t": "people yawned less when"}, {"s": 88.56, "e": 89.54, "t": "they held something cold"}, {"s": 89.58, "e": 90.58, "t": "against their forehead."}, {"s": 90.72, "e": 91.64, "t": "People also tend to"}, {"s": 91.68, "e": 92.54, "t": "yawn more in certain"}, {"s": 92.62, "e": 93.139, "t": "temperatures,"}, {"s": 93.22, "e": 94.48, "t": "which fits the brain-cooling"}, {"s": 94.559, "e": 94.98, "t": "idea."}, {"s": 95.22, "e": 96.18, "t": "It's still being studied,"}, {"s": 96.26, "e": 96.92, "t": "but it's a fun"}, {"s": 97.02, "e": 97.4, "t": "clue."}, {"s": 107.38, "e": 108.18, "t": "Plot twist!"}, {"s": 108.36, "e": 109.62, "t": "Contagious yawning may be"}, {"s": 109.68, "e": 110.68, "t": "linked to connection."}, {"s": 110.9, "e": 112.0, "t": "Some studies found people"}, {"s": 112.04, "e": 113.3, "t": "catch yawns more easily"}, {"s": 113.32, "e": 114.32, "t": "from friends and family"}, {"s": 114.36, "e": 115.36, "t": "than from strangers."}, {"s": 115.54, "e": 116.64, "t": "And even dogs can"}, {"s": 116.66, "e": 117.36, "t": "catch a yawn from"}, {"s": 117.4, "e": 118.08, "t": "their humans."}, {"s": 118.3, "e": 119.3, "t": "Young kids often don't"}, {"s": 119.34, "e": 120.42, "t": "catch yawns until they're"}, {"s": 120.48, "e": 121.42, "t": "around four or five"}, {"s": 121.48, "e": 122.1, "t": "years old."}, {"s": 132.18, "e": 132.86, "t": "Be honest."}, {"s": 132.96, "e": 133.7, "t": "How many times did"}, {"s": 133.74, "e": 134.66, "t": "you yawn during this"}, {"s": 134.7, "e": 135.12, "t": "video?"}, {"s": 135.28, "e": 135.72, "t": "Tell me in the"}, {"s": 135.76, "e": 136.14, "t": "comments,"}, {"s": 136.2, "e": 137.3, "t": "and subscribe for more"}, {"s": 137.34, "e": 137.92, "t": "HowCome!"}]