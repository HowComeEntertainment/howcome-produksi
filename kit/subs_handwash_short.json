[{"s": 0.64, "e": 1.62, "t": "You leave the bathroom,"}, {"s": 1.86, "e": 2.76, "t": "and you didn't wash"}, {"s": 2.8, "e": 3.34, "t": "your hands."}, {"s": 3.68, "e": 4.6, "t": "What if you never"}, {"s": 4.66, "e": 5.94, "t": "washed your hands after"}, {"s": 5.98, "e": 6.86, "t": "the toilet again?"}, {"s": 7.24, "e": 7.9, "t": "Be honest."}, {"s": 8.26, "e": 8.88, "t": "The good news?"}, {"s": 9.16, "e": 10.58, "t": "Simple handwashing with soap"}, {"s": 10.62, "e": 11.9, "t": "makes a huge difference."}, {"s": 12.18, "e": 13.02, "t": "Studies show it can"}, {"s": 13.06, "e": 14.38, "t": "cut diarrhea illnesses by"}, {"s": 14.46, "e": 15.26, "t": "about a quarter to"}, {"s": 15.32, "e": 15.8, "t": "a third."}, {"s": 16.0, "e": 16.54, "t": "Just soap,"}, {"s": 16.78, "e": 17.06, "t": "water,"}, {"s": 17.18, "e": 18.34, "t": "and about twenty seconds."}, {"s": 18.56, "e": 19.48, "t": "Soap works because it"}, {"s": 19.5, "e": 20.64, "t": "breaks apart the oily"}, {"s": 20.7, "e": 21.7, "t": "layer that helps germs"}, {"s": 21.76, "e": 22.64, "t": "stick to your skin."}, {"s": 22.8, "e": 23.7, "t": "Then the water rinses"}, {"s": 23.74, "e": 24.3, "t": "them away."}, {"s": 30.404, "e": 31.184, "t": "Plot twist!"}, {"s": 31.384, "e": 32.064, "t": "How you dry your"}, {"s": 32.104, "e": 33.124, "t": "hands matters too."}, {"s": 33.324, "e": 34.224, "t": "One study found that"}, {"s": 34.284, "e": 35.724, "t": "powerful jet air dryers"}, {"s": 35.764, "e": 37.004, "t": "blew bacteria around the"}, {"s": 37.044, "e": 38.184, "t": "bathroom much more than"}, {"s": 38.224, "e": 39.024, "t": "paper towels."}, {"s": 39.224, "e": 40.084, "t": "So grab a towel"}, {"s": 40.164, "e": 40.724, "t": "if you can."}, {"s": 40.884, "e": 41.864, "t": "Hot water doesn't kill"}, {"s": 41.944, "e": 42.484, "t": "more germs,"}, {"s": 42.564, "e": 43.064, "t": "by the way."}, {"s": 43.264, "e": 44.684, "t": "Any comfortable temperature works"}, {"s": 44.744, "e": 45.444, "t": "if you use soap"}, {"s": 45.464, "e": 46.064, "t": "and scrub."}, {"s": 46.504, "e": 47.004, "t": "Be honest."}, {"s": 47.124, "e": 47.824, "t": "Do you always wash"}, {"s": 47.864, "e": 48.324, "t": "your hands?"}, {"s": 48.564, "e": 48.984, "t": "Tell me in the"}, {"s": 49.024, "e": 49.464, "t": "comments,"}, {"s": 49.544, "e": 50.504, "t": "and subscribe for more"}, {"s": 50.544, "e": 51.104, "t": "HowCome!"}]