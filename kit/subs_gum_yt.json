[{"s": 0.66, "e": 0.98, "t": "Gulp."}, {"s": 1.22, "e": 2.04, "t": "You just swallowed your"}, {"s": 2.18, "e": 2.58, "t": "gum."}, {"s": 2.8, "e": 3.74, "t": "Remember what they told"}, {"s": 3.8, "e": 3.92, "t": "you?"}, {"s": 4.1, "e": 4.8, "t": "It stays in your"}, {"s": 4.86, "e": 6.5, "t": "stomach for seven years."}, {"s": 6.6, "e": 7.12, "t": "But what if you"}, {"s": 7.18, "e": 8.66, "t": "swallowed gum every day?"}, {"s": 8.88, "e": 9.7, "t": "Is your stomach a"}, {"s": 9.74, "e": 10.46, "t": "gum museum?"}, {"s": 20.916, "e": 21.736, "t": "Chewing gum is made"}, {"s": 21.776, "e": 22.476, "t": "with a gum base"}, {"s": 22.516, "e": 23.376, "t": "that your body really"}, {"s": 23.416, "e": 24.316, "t": "can't digest."}, {"s": 24.456, "e": 25.336, "t": "That part is true."}, {"s": 25.476, "e": 26.415, "t": "The sweet flavor gets"}, {"s": 26.456, "e": 26.956, "t": "absorbed,"}, {"s": 27.056, "e": 28.056, "t": "but the rubbery base"}, {"s": 28.116, "e": 29.076, "t": "just stays rubbery."}, {"s": 29.256, "e": 30.076, "t": "Gum base is made"}, {"s": 30.096, "e": 31.356, "t": "from rubbery materials,"}, {"s": 31.456, "e": 32.436, "t": "and some versions are"}, {"s": 32.476, "e": 33.416, "t": "similar to stuff used"}, {"s": 33.456, "e": 34.936, "t": "in other everyday products."}, {"s": 35.136, "e": 36.096, "t": "Your stomach acid and"}, {"s": 36.156, "e": 37.376, "t": "enzymes can't really break"}, {"s": 37.416, "e": 37.956, "t": "it down."}, {"s": 48.452, "e": 49.092, "t": "But your gut is"}, {"s": 49.152, "e": 50.132, "t": "not a storage room."}, {"s": 50.272, "e": 50.832, "t": "It's more like a"}, {"s": 50.872, "e": 51.632, "t": "conveyor belt."}, {"s": 51.812, "e": 53.152, "t": "Muscles keep pushing everything"}, {"s": 53.292, "e": 53.652, "t": "forward,"}, {"s": 53.812, "e": 54.532, "t": "even the stuff you"}, {"s": 54.572, "e": 55.332, "t": "can't digest,"}, {"s": 55.412, "e": 56.172, "t": "like some seeds and"}, {"s": 56.292, "e": 56.912, "t": "fibers."}, {"s": 57.072, "e": 57.972, "t": "Your body doesn't need"}, {"s": 57.992, "e": 59.052, "t": "to digest something to"}, {"s": 59.092, "e": 59.732, "t": "get rid of it."}, {"s": 59.872, "e": 60.692, "t": "A single piece of"}, {"s": 60.712, "e": 61.552, "t": "gum is small and"}, {"s": 61.692, "e": 62.032, "t": "soft,"}, {"s": 62.152, "e": 62.992, "t": "so it usually just"}, {"s": 63.032, "e": 64.212, "t": "slides through with everything"}, {"s": 64.272, "e": 64.912, "t": "else you ate."}, {"s": 65.032, "e": 65.892, "t": "The same thing happens"}, {"s": 65.912, "e": 66.772, "t": "with corn skins,"}, {"s": 66.892, "e": 67.472, "t": "which is why you"}, {"s": 67.512, "e": 68.432, "t": "sometimes see them come"}, {"s": 68.492, "e": 69.352, "t": "out the other end."}, {"s": 79.688, "e": 80.348, "t": "So the truth?"}, {"s": 80.528, "e": 81.448, "t": "A swallowed piece of"}, {"s": 81.488, "e": 82.508, "t": "gum usually leaves your"}, {"s": 82.528, "e": 83.168, "t": "body in a few"}, {"s": 83.188, "e": 83.568, "t": "days,"}, {"s": 83.688, "e": 84.828, "t": "not seven years."}, {"s": 84.988, "e": 86.168, "t": "Doctors only saw real"}, {"s": 86.208, "e": 87.548, "t": "trouble in rare cases,"}, {"s": 87.708, "e": 88.848, "t": "mostly kids who swallowed"}, {"s": 88.908, "e": 89.608, "t": "tons of gum,"}, {"s": 89.808, "e": 90.728, "t": "often with other things"}, {"s": 90.768, "e": 91.528, "t": "like coins."}, {"s": 91.708, "e": 92.728, "t": "So swallowing a piece"}, {"s": 92.768, "e": 93.588, "t": "now and then isn't"}, {"s": 93.628, "e": 94.228, "t": "a big deal,"}, {"s": 94.368, "e": 95.108, "t": "but gum is still"}, {"s": 95.148, "e": 95.907, "t": "made for chewing,"}, {"s": 95.987, "e": 96.668, "t": "not eating."}, {"s": 107.044, "e": 107.864, "t": "Plot twist!"}, {"s": 108.024, "e": 108.924, "t": "People have chewed gum"}, {"s": 108.964, "e": 110.284, "t": "for thousands of years."}, {"s": 110.444, "e": 111.404, "t": "Scientists found a piece"}, {"s": 111.464, "e": 112.644, "t": "of ancient chewed tree"}, {"s": 112.764, "e": 113.024, "t": "tar,"}, {"s": 113.184, "e": 114.544, "t": "about five thousand seven"}, {"s": 114.584, "e": 115.444, "t": "hundred years old,"}, {"s": 115.544, "e": 116.084, "t": "and they got the"}, {"s": 116.164, "e": 117.564, "t": "chewer's full DNA from"}, {"s": 117.624, "e": 117.804, "t": "it."}, {"s": 117.924, "e": 118.644, "t": "It even had bits"}, {"s": 118.684, "e": 119.804, "t": "of hazelnut and duck"}, {"s": 119.864, "e": 120.164, "t": "in it."}, {"s": 120.264, "e": 121.844, "t": "That's like a five-thousand-year-old"}, {"s": 121.864, "e": 122.624, "t": "dinner receipt."}, {"s": 133.02, "e": 133.26, "t": "So,"}, {"s": 133.42, "e": 134.2, "t": "do you swallow your"}, {"s": 134.22, "e": 134.94, "t": "gum or spit it"}, {"s": 135.04, "e": 135.22, "t": "out?"}, {"s": 135.38, "e": 135.8, "t": "Tell me in the"}, {"s": 135.84, "e": 136.26, "t": "comments,"}, {"s": 136.3, "e": 137.3, "t": "and subscribe for more"}, {"s": 137.34, "e": 137.92, "t": "HowCome!"}]