[{"s": 0.12, "e": 0.66, "t": "Parents,"}, {"s": 0.92, "e": 1.56, "t": "teachers,"}, {"s": 1.7, "e": 2.66, "t": "cereal boxes..."}, {"s": 2.74, "e": 3.74, "t": "they all say breakfast"}, {"s": 3.78, "e": 4.82, "t": "is the most important"}, {"s": 4.86, "e": 5.6, "t": "meal of the day."}, {"s": 5.7, "e": 6.28, "t": "But what if you"}, {"s": 6.4, "e": 7.32, "t": "skipped it for thirty"}, {"s": 7.44, "e": 7.9, "t": "days?"}, {"s": 8.1, "e": 9.42, "t": "Week one is rough."}, {"s": 9.54, "e": 10.42, "t": "Your hunger hormone,"}, {"s": 10.5, "e": 10.88, "t": "ghrelin,"}, {"s": 11.02, "e": 11.9, "t": "follows your schedule,"}, {"s": 12.04, "e": 12.86, "t": "so your stomach still"}, {"s": 12.88, "e": 14.06, "t": "growls at breakfast time."}, {"s": 14.78, "e": 15.32, "t": "Cranky,"}, {"s": 15.56, "e": 16.04, "t": "foggy,"}, {"s": 16.2, "e": 17.22, "t": "dreaming of donuts."}, {"s": 17.32, "e": 18.02, "t": "But after a couple"}, {"s": 18.06, "e": 18.46, "t": "of weeks,"}, {"s": 18.54, "e": 19.24, "t": "for many people,"}, {"s": 19.38, "e": 20.66, "t": "that morning hunger fades."}, {"s": 20.861, "e": 22.84, "t": "\"Breakfast kickstarts your metabolism\"?"}, {"s": 23.28, "e": 24.479, "t": "When researchers tested it,"}, {"s": 24.6, "e": 25.74, "t": "breakfast didn't change how"}, {"s": 25.76, "e": 26.94, "t": "many calories people burned"}, {"s": 26.98, "e": 27.62, "t": "at rest."}, {"s": 27.76, "e": 28.66, "t": "Here's the shock."}, {"s": 28.8, "e": 30.18, "t": "A big BMJ review"}, {"s": 30.22, "e": 31.7, "t": "found breakfast eaters actually"}, {"s": 31.76, "e": 32.58, "t": "ate about two hundred"}, {"s": 32.78, "e": 33.88, "t": "sixty more calories a"}, {"s": 33.92, "e": 34.22, "t": "day,"}, {"s": 34.32, "e": 35.42, "t": "and breakfast didn't help"}, {"s": 35.46, "e": 36.32, "t": "people lose weight."}, {"s": 38.684, "e": 39.504, "t": "Plot twist!"}, {"s": 39.684, "e": 40.884, "t": "Skipping only works if"}, {"s": 40.944, "e": 41.864, "t": "lunch isn't a junk"}, {"s": 41.884, "e": 42.444, "t": "food party."}, {"s": 42.584, "e": 43.164, "t": "And kids,"}, {"s": 43.304, "e": 43.644, "t": "teens,"}, {"s": 43.684, "e": 44.744, "t": "and people with diabetes"}, {"s": 44.784, "e": 45.864, "t": "on medication should be"}, {"s": 45.904, "e": 46.344, "t": "careful."}, {"s": 46.484, "e": 47.524, "t": "What really matters is"}, {"s": 47.564, "e": 48.264, "t": "what you eat all"}, {"s": 48.304, "e": 48.624, "t": "day."}, {"s": 48.864, "e": 48.964, "t": "So,"}, {"s": 49.384, "e": 50.524, "t": "team breakfast or team"}, {"s": 50.624, "e": 50.884, "t": "skip?"}, {"s": 51.044, "e": 51.484, "t": "Tell me in the"}, {"s": 51.524, "e": 51.944, "t": "comments,"}, {"s": 52.004, "e": 52.944, "t": "and subscribe for more"}, {"s": 52.984, "e": 53.504, "t": "HowCome!"}]