[{"s": 0.12, "e": 0.9, "t": "No toothbrush."}, {"s": 1.3, "e": 2.3, "t": "No toothpaste."}, {"s": 2.78, "e": 3.4, "t": "Forever."}, {"s": 3.7, "e": 4.36, "t": "What if you never"}, {"s": 4.46, "e": 5.62, "t": "brushed your teeth again?"}, {"s": 5.84, "e": 6.76, "t": "Not even once?"}, {"s": 7.2, "e": 8.039, "t": "Your mouth is home"}, {"s": 8.08, "e": 9.08, "t": "to hundreds of kinds"}, {"s": 9.12, "e": 9.82, "t": "of bacteria."}, {"s": 10.0, "e": 10.98, "t": "Most are harmless,"}, {"s": 11.12, "e": 12.42, "t": "but some love sugar"}, {"s": 12.58, "e": 13.28, "t": "just as much as"}, {"s": 13.34, "e": 13.68, "t": "you do."}, {"s": 13.82, "e": 14.7, "t": "And every time you"}, {"s": 14.76, "e": 14.9, "t": "eat,"}, {"s": 15.14, "e": 16.14, "t": "you feed them too."}, {"s": 16.54, "e": 17.5, "t": "Within hours,"}, {"s": 17.58, "e": 18.44, "t": "they build a sticky"}, {"s": 18.56, "e": 19.6, "t": "film called plaque."}, {"s": 19.82, "e": 20.34, "t": "Leave it for a"}, {"s": 20.38, "e": 20.86, "t": "few days,"}, {"s": 20.96, "e": 21.9, "t": "and it hardens into"}, {"s": 21.96, "e": 22.38, "t": "tartar,"}, {"s": 22.66, "e": 23.44, "t": "so rough that a"}, {"s": 23.5, "e": 24.64, "t": "toothbrush can't remove it"}, {"s": 24.7, "e": 25.16, "t": "anymore."}, {"s": 25.74, "e": 26.4, "t": "And your breath?"}, {"s": 26.76, "e": 27.2, "t": "Yikes."}, {"s": 27.68, "e": 28.84, "t": "In a classic experiment,"}, {"s": 28.98, "e": 30.64, "t": "healthy volunteers stopped cleaning"}, {"s": 30.68, "e": 31.2, "t": "their teeth."}, {"s": 31.34, "e": 32.06, "t": "Within two to three"}, {"s": 32.159, "e": 32.439, "t": "weeks,"}, {"s": 32.64, "e": 33.72, "t": "every single one got"}, {"s": 33.8, "e": 34.22, "t": "swollen,"}, {"s": 34.36, "e": 35.24, "t": "bleeding gums."}, {"s": 35.38, "e": 36.26, "t": "When they started brushing"}, {"s": 36.32, "e": 36.6, "t": "again,"}, {"s": 36.76, "e": 37.3, "t": "it healed."}, {"s": 39.316, "e": 40.056, "t": "Plot twist!"}, {"s": 40.236, "e": 42.256, "t": "Ancient hunter-gatherers never brushed,"}, {"s": 42.356, "e": 43.156, "t": "yet they had far"}, {"s": 43.276, "e": 44.356, "t": "fewer cavities than we"}, {"s": 44.396, "e": 44.616, "t": "do."}, {"s": 44.776, "e": 45.356, "t": "The difference?"}, {"s": 45.976, "e": 46.656, "t": "They didn't eat our"}, {"s": 46.716, "e": 47.936, "t": "sugar and soft processed"}, {"s": 48.016, "e": 48.376, "t": "food."}, {"s": 48.816, "e": 48.996, "t": "So,"}, {"s": 49.136, "e": 49.796, "t": "how many times a"}, {"s": 49.836, "e": 50.676, "t": "day do you really"}, {"s": 50.696, "e": 51.076, "t": "brush?"}, {"s": 51.236, "e": 51.636, "t": "Tell me in the"}, {"s": 51.676, "e": 52.096, "t": "comments,"}, {"s": 52.196, "e": 53.236, "t": "and subscribe for more"}, {"s": 53.276, "e": 53.836, "t": "HowCome!"}]