[{"s": 0.18, "e": 0.84, "t": "Quick question."}, {"s": 1.02, "e": 1.8, "t": "Are you blinking right"}, {"s": 1.84, "e": 2.0, "t": "now?"}, {"s": 2.48, "e": 3.42, "t": "Now you're thinking about"}, {"s": 3.46, "e": 3.54, "t": "it."}, {"s": 3.62, "e": 4.12, "t": "But what if you"}, {"s": 4.18, "e": 5.58, "t": "stopped blinking completely?"}, {"s": 6.04, "e": 6.8, "t": "Even for a minute?"}, {"s": 17.352, "e": 18.532, "t": "You blink around fifteen"}, {"s": 18.572, "e": 19.352, "t": "to twenty times a"}, {"s": 19.412, "e": 20.632, "t": "minute without even noticing."}, {"s": 20.752, "e": 21.912, "t": "That's thousands of blinks"}, {"s": 21.972, "e": 22.352, "t": "a day."}, {"s": 22.532, "e": 23.472, "t": "Each one spreads a"}, {"s": 23.492, "e": 24.412, "t": "thin layer of tears"}, {"s": 24.472, "e": 25.272, "t": "across your eyes,"}, {"s": 25.392, "e": 26.411, "t": "like a tiny windshield"}, {"s": 26.472, "e": 26.812, "t": "wiper."}, {"s": 26.972, "e": 28.272, "t": "Blinking also sweeps away"}, {"s": 28.292, "e": 28.612, "t": "dust,"}, {"s": 28.692, "e": 29.352, "t": "and it takes only"}, {"s": 29.412, "e": 30.072, "t": "about a tenth of"}, {"s": 30.112, "e": 30.572, "t": "a second."}, {"s": 30.732, "e": 31.832, "t": "It happens so fast"}, {"s": 31.872, "e": 32.792, "t": "that your brain hides"}, {"s": 32.832, "e": 33.792, "t": "the darkness from you."}, {"s": 44.444, "e": 45.164, "t": "Stop blinking,"}, {"s": 45.264, "e": 46.384, "t": "and within seconds that"}, {"s": 46.464, "e": 47.604, "t": "tear layer starts breaking"}, {"s": 47.724, "e": 47.924, "t": "up."}, {"s": 48.084, "e": 48.964, "t": "Your eyes sting,"}, {"s": 49.144, "e": 49.464, "t": "burn,"}, {"s": 49.504, "e": 50.324, "t": "and turn red."}, {"s": 50.484, "e": 51.004, "t": "Keep going,"}, {"s": 51.064, "e": 51.744, "t": "and the surface of"}, {"s": 51.784, "e": 52.724, "t": "your eye gets dry"}, {"s": 52.744, "e": 53.544, "t": "and irritated."}, {"s": 53.664, "e": 54.324, "t": "It can even get"}, {"s": 54.364, "e": 55.464, "t": "damaged over time."}, {"s": 55.624, "e": 56.564, "t": "Your eyes would also"}, {"s": 56.604, "e": 57.624, "t": "lose their protection."}, {"s": 57.844, "e": 58.764, "t": "Dust and germs would"}, {"s": 58.844, "e": 59.644, "t": "stay on the surface"}, {"s": 59.684, "e": 60.664, "t": "instead of getting washed"}, {"s": 60.724, "e": 61.124, "t": "away."}, {"s": 61.304, "e": 62.064, "t": "That's why people who"}, {"s": 62.124, "e": 63.144, "t": "can't fully close their"}, {"s": 63.224, "e": 64.524, "t": "eyes need special drops"}, {"s": 64.544, "e": 65.844, "t": "and care from doctors."}, {"s": 76.636, "e": 77.376, "t": "And here's the thing."}, {"s": 77.556, "e": 78.856, "t": "You're already blinking way"}, {"s": 78.916, "e": 79.616, "t": "less right now."}, {"s": 79.876, "e": 81.056, "t": "Studies found people blink"}, {"s": 81.116, "e": 81.956, "t": "much less when they"}, {"s": 82.016, "e": 82.916, "t": "stare at screens."}, {"s": 83.096, "e": 84.096, "t": "That's one big reason"}, {"s": 84.136, "e": 85.216, "t": "your eyes feel tired"}, {"s": 85.236, "e": 86.316, "t": "and dry after hours"}, {"s": 86.376, "e": 87.036, "t": "on your phone."}, {"s": 87.216, "e": 87.856, "t": "In one study,"}, {"s": 87.976, "e": 89.176, "t": "people's blink rate dropped"}, {"s": 89.216, "e": 90.436, "t": "from about eighteen times"}, {"s": 90.476, "e": 91.196, "t": "a minute to just"}, {"s": 91.236, "e": 92.116, "t": "a few while working"}, {"s": 92.156, "e": 92.836, "t": "on a computer."}, {"s": 103.588, "e": 104.328, "t": "Plot twist!"}, {"s": 104.528, "e": 105.608, "t": "Blinking isn't just for"}, {"s": 105.647, "e": 106.248, "t": "your eyes."}, {"s": 106.428, "e": 107.088, "t": "In one study,"}, {"s": 107.228, "e": 108.348, "t": "scientists saw that right"}, {"s": 108.408, "e": 109.288, "t": "after people blink,"}, {"s": 109.428, "e": 110.648, "t": "the brain's resting network"}, {"s": 110.728, "e": 111.388, "t": "lights up for a"}, {"s": 111.428, "e": 111.828, "t": "moment."}, {"s": 112.028, "e": 112.928, "t": "Every blink might be"}, {"s": 112.968, "e": 114.268, "t": "a tiny mental break."}, {"s": 114.528, "e": 115.208, "t": "So if you've been"}, {"s": 115.268, "e": 116.068, "t": "staring at your phone,"}, {"s": 116.168, "e": 117.788, "t": "try the twenty-twenty-twenty rule."}, {"s": 117.988, "e": 118.788, "t": "Every twenty minutes,"}, {"s": 118.888, "e": 119.768, "t": "look at something twenty"}, {"s": 119.888, "e": 120.728, "t": "feet away for twenty"}, {"s": 120.848, "e": 121.348, "t": "seconds."}, {"s": 131.961, "e": 132.68, "t": "Did you blink while"}, {"s": 132.72, "e": 133.3, "t": "watching this?"}, {"s": 133.56, "e": 134.52, "t": "Team blink or team"}, {"s": 134.68, "e": 135.0, "t": "stare?"}, {"s": 135.16, "e": 135.58, "t": "Tell me in the"}, {"s": 135.62, "e": 136.04, "t": "comments,"}, {"s": 136.12, "e": 137.2, "t": "and subscribe for more"}, {"s": 137.24, "e": 137.86, "t": "HowCome!"}]