[{"s": 0.18, "e": 0.78, "t": "One can in the"}, {"s": 0.84, "e": 1.18, "t": "morning,"}, {"s": 1.44, "e": 2.26, "t": "one after lunch,"}, {"s": 2.46, "e": 3.42, "t": "one before the gym."}, {"s": 3.72, "e": 4.42, "t": "What if you drank"}, {"s": 4.46, "e": 5.86, "t": "an energy drink every"}, {"s": 6.06, "e": 6.78, "t": "single day?"}, {"s": 23.772, "e": 24.672, "t": "A big can can"}, {"s": 24.712, "e": 25.772, "t": "pack around one hundred"}, {"s": 25.932, "e": 27.492, "t": "sixty milligrams of caffeine,"}, {"s": 27.612, "e": 28.652, "t": "and some have over"}, {"s": 28.692, "e": 30.092, "t": "fifty grams of sugar."}, {"s": 30.212, "e": 31.232, "t": "That's more sugar than"}, {"s": 31.272, "e": 32.312, "t": "many adults should have"}, {"s": 32.332, "e": 33.112, "t": "in a whole day."}, {"s": 33.252, "e": 33.812, "t": "And if you drink"}, {"s": 33.852, "e": 34.812, "t": "it in the afternoon?"}, {"s": 34.972, "e": 36.152, "t": "That caffeine can still"}, {"s": 36.312, "e": 37.312, "t": "steal sleep at night."}, {"s": 54.364, "e": 55.044, "t": "Here's the trick."}, {"s": 55.184, "e": 56.704, "t": "Caffeine blocks adenosine,"}, {"s": 56.864, "e": 58.204, "t": "your brain's sleepy signal."}, {"s": 58.304, "e": 59.824, "t": "But adenosine keeps piling"}, {"s": 59.964, "e": 60.144, "t": "up."}, {"s": 60.244, "e": 61.264, "t": "When the caffeine wears"}, {"s": 61.344, "e": 61.564, "t": "off,"}, {"s": 61.684, "e": 62.364, "t": "it all hits at"}, {"s": 62.484, "e": 62.784, "t": "once."}, {"s": 62.944, "e": 63.864, "t": "That's the crash."}, {"s": 80.836, "e": 81.696, "t": "In one study,"}, {"s": 81.836, "e": 83.036, "t": "healthy young adults drank"}, {"s": 83.076, "e": 84.256, "t": "a single energy drink,"}, {"s": 84.376, "e": 85.276, "t": "and their blood pressure"}, {"s": 85.436, "e": 86.336, "t": "jumped more than with"}, {"s": 86.376, "e": 87.296, "t": "caffeine alone."}, {"s": 87.496, "e": 88.716, "t": "Some even showed changes"}, {"s": 88.756, "e": 89.636, "t": "in their heart rhythm."}, {"s": 106.548, "e": 107.328, "t": "Plot twist!"}, {"s": 107.488, "e": 108.528, "t": "Your body adapts."}, {"s": 108.708, "e": 109.788, "t": "Drink one every day,"}, {"s": 109.908, "e": 110.728, "t": "and you start needing"}, {"s": 110.768, "e": 111.428, "t": "it just to feel"}, {"s": 111.548, "e": 111.968, "t": "normal."}, {"s": 112.168, "e": 112.748, "t": "Skip a day?"}, {"s": 112.948, "e": 113.348, "t": "Headache,"}, {"s": 113.548, "e": 113.908, "t": "fog,"}, {"s": 114.048, "e": 114.668, "t": "bad mood."}, {"s": 114.808, "e": 116.108, "t": "That's caffeine withdrawal."}, {"s": 133.16, "e": 134.38, "t": "Team energy drink or"}, {"s": 134.5, "e": 135.14, "t": "team water?"}, {"s": 135.28, "e": 135.74, "t": "Tell me in the"}, {"s": 135.78, "e": 136.2, "t": "comments,"}, {"s": 136.26, "e": 137.26, "t": "and subscribe for more"}, {"s": 137.3, "e": 137.92, "t": "HowCome!"}]