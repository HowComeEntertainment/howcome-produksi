[{"s": 1.06, "e": 1.6, "t": "Yawn."}, {"s": 2.5, "e": 3.26, "t": "Did you just yawn"}, {"s": 3.36, "e": 3.58, "t": "too?"}, {"s": 3.8, "e": 4.94, "t": "It's so contagious."}, {"s": 5.2, "e": 5.74, "t": "But what if you"}, {"s": 5.76, "e": 7.26, "t": "could never yawn again?"}, {"s": 7.64, "e": 8.4, "t": "I bet you're fighting"}, {"s": 8.48, "e": 9.14, "t": "one right now."}, {"s": 9.4, "e": 10.3, "t": "A newer idea is"}, {"s": 10.34, "e": 11.54, "t": "that yawning helps cool"}, {"s": 11.6, "e": 12.16, "t": "your brain."}, {"s": 12.36, "e": 13.26, "t": "That big gulp of"}, {"s": 13.36, "e": 14.08, "t": "air and the stretch"}, {"s": 14.14, "e": 14.86, "t": "of your jaw can"}, {"s": 14.88, "e": 15.98, "t": "bring in cooler blood."}, {"s": 16.14, "e": 16.66, "t": "In studies,"}, {"s": 16.76, "e": 17.78, "t": "people yawned less when"}, {"s": 17.82, "e": 18.8, "t": "they held something cold"}, {"s": 18.84, "e": 19.84, "t": "against their forehead."}, {"s": 19.98, "e": 20.9, "t": "People also tend to"}, {"s": 20.94, "e": 21.8, "t": "yawn more in certain"}, {"s": 21.88, "e": 22.399, "t": "temperatures,"}, {"s": 22.48, "e": 23.74, "t": "which fits the brain-cooling"}, {"s": 23.819, "e": 24.24, "t": "idea."}, {"s": 24.48, "e": 25.44, "t": "It's still being studied,"}, {"s": 25.52, "e": 26.18, "t": "but it's a fun"}, {"s": 26.28, "e": 26.66, "t": "clue."}, {"s": 31.22, "e": 32.02, "t": "Plot twist!"}, {"s": 32.2, "e": 33.46, "t": "Contagious yawning may be"}, {"s": 33.52, "e": 34.52, "t": "linked to connection."}, {"s": 34.74, "e": 35.84, "t": "Some studies found people"}, {"s": 35.88, "e": 37.14, "t": "catch yawns more easily"}, {"s": 37.16, "e": 38.16, "t": "from friends and family"}, {"s": 38.2, "e": 39.2, "t": "than from strangers."}, {"s": 39.38, "e": 40.48, "t": "And even dogs can"}, {"s": 40.5, "e": 41.2, "t": "catch a yawn from"}, {"s": 41.24, "e": 41.92, "t": "their humans."}, {"s": 42.14, "e": 43.14, "t": "Young kids often don't"}, {"s": 43.18, "e": 44.26, "t": "catch yawns until they're"}, {"s": 44.32, "e": 45.26, "t": "around four or five"}, {"s": 45.32, "e": 45.94, "t": "years old."}, {"s": 46.34, "e": 47.02, "t": "Be honest."}, {"s": 47.12, "e": 47.86, "t": "How many times did"}, {"s": 47.9, "e": 48.82, "t": "you yawn during this"}, {"s": 48.86, "e": 49.28, "t": "video?"}, {"s": 49.44, "e": 49.88, "t": "Tell me in the"}, {"s": 49.92, "e": 50.3, "t": "comments,"}, {"s": 50.36, "e": 51.46, "t": "and subscribe for more"}, {"s": 51.5, "e": 52.08, "t": "HowCome!"}]