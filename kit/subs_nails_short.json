[{"s": 0.22, "e": 0.46, "t": "Snip,"}, {"s": 0.54, "e": 0.82, "t": "snip."}, {"s": 0.98, "e": 2.22, "t": "Everyone cuts their nails."}, {"s": 2.32, "e": 2.92, "t": "But what if you"}, {"s": 2.98, "e": 4.1, "t": "never cut them again?"}, {"s": 4.26, "e": 5.22, "t": "Not even once?"}, {"s": 5.42, "e": 6.32, "t": "Your fingers would look"}, {"s": 6.36, "e": 7.16, "t": "like claws."}, {"s": 7.54, "e": 8.52, "t": "Keep going for years,"}, {"s": 8.58, "e": 9.46, "t": "and nails don't just"}, {"s": 9.5, "e": 10.18, "t": "grow straight."}, {"s": 10.26, "e": 11.14, "t": "They start to curl"}, {"s": 11.18, "e": 11.84, "t": "and twist."}, {"s": 12.02, "e": 12.76, "t": "One woman grew her"}, {"s": 12.78, "e": 13.94, "t": "nails for almost thirty"}, {"s": 14.04, "e": 14.4, "t": "years,"}, {"s": 14.48, "e": 15.48, "t": "and together they reached"}, {"s": 15.54, "e": 16.62, "t": "over eight meters."}, {"s": 16.76, "e": 17.6, "t": "She couldn't do simple"}, {"s": 17.64, "e": 18.38, "t": "things like pick up"}, {"s": 18.42, "e": 18.94, "t": "a coin."}, {"s": 19.12, "e": 20.36, "t": "Super long nails also"}, {"s": 20.38, "e": 21.22, "t": "get weaker as they"}, {"s": 21.26, "e": 21.56, "t": "grow,"}, {"s": 21.7, "e": 22.48, "t": "so they can crack"}, {"s": 22.52, "e": 23.24, "t": "or break off,"}, {"s": 23.36, "e": 24.4, "t": "sometimes painfully."}, {"s": 28.996, "e": 29.816, "t": "Plot twist!"}, {"s": 29.936, "e": 31.076, "t": "You've probably heard nails"}, {"s": 31.116, "e": 32.255, "t": "keep growing after death."}, {"s": 32.416, "e": 32.936, "t": "They don't."}, {"s": 33.076, "e": 34.056, "t": "The skin just dries"}, {"s": 34.136, "e": 34.976, "t": "out and pulls back,"}, {"s": 35.056, "e": 36.156, "t": "so nails look longer."}, {"s": 36.256, "e": 37.096, "t": "And here's a bonus:"}, {"s": 37.236, "e": 37.956, "t": "the nails on your"}, {"s": 37.996, "e": 39.276, "t": "dominant hand often grow"}, {"s": 39.316, "e": 40.076, "t": "a bit faster."}, {"s": 40.236, "e": 41.196, "t": "Nails can also show"}, {"s": 41.236, "e": 42.156, "t": "hints about your health,"}, {"s": 42.316, "e": 43.556, "t": "like lines or spots,"}, {"s": 43.696, "e": 44.876, "t": "so doctors sometimes look"}, {"s": 44.916, "e": 45.276, "t": "at them."}, {"s": 45.716, "e": 46.416, "t": "So how often do"}, {"s": 46.456, "e": 47.316, "t": "you cut your nails?"}, {"s": 47.456, "e": 48.456, "t": "Team short nails or"}, {"s": 48.576, "e": 49.396, "t": "team long nails?"}, {"s": 49.516, "e": 49.956, "t": "Tell me in the"}, {"s": 49.996, "e": 50.416, "t": "comments,"}, {"s": 50.476, "e": 51.476, "t": "and subscribe for more"}, {"s": 51.516, "e": 52.116, "t": "HowCome!"}]