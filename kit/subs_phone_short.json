[{"s": 0.14, "e": 0.66, "t": "Bzzz."}, {"s": 0.98, "e": 1.88, "t": "You grab your phone."}, {"s": 2.6, "e": 3.0, "t": "Nothing."}, {"s": 3.82, "e": 4.6, "t": "Five minutes later,"}, {"s": 5.0, "e": 5.46, "t": "again."}, {"s": 6.18, "e": 6.88, "t": "What if you checked"}, {"s": 6.92, "e": 8.34, "t": "your phone every five"}, {"s": 8.44, "e": 8.82, "t": "minutes,"}, {"s": 9.26, "e": 10.1, "t": "all day long?"}, {"s": 11.52, "e": 12.18, "t": "Sound familiar?"}, {"s": 12.8, "e": 13.8, "t": "Here's the wild part."}, {"s": 14.02, "e": 14.9, "t": "In one experiment,"}, {"s": 15.22, "e": 16.48, "t": "people did harder thinking"}, {"s": 16.58, "e": 17.88, "t": "tests just because their"}, {"s": 17.9, "e": 18.64, "t": "phone was sitting on"}, {"s": 18.68, "e": 19.24, "t": "the desk."}, {"s": 19.62, "e": 20.14, "t": "Turned off,"}, {"s": 20.36, "e": 20.96, "t": "face down,"}, {"s": 21.18, "e": 21.759, "t": "didn't matter."}, {"s": 22.199, "e": 23.22, "t": "Phone in another room?"}, {"s": 23.56, "e": 24.38, "t": "They scored better."}, {"s": 24.92, "e": 26.04, "t": "Just having it nearby"}, {"s": 26.08, "e": 26.74, "t": "seems to use up"}, {"s": 26.78, "e": 27.56, "t": "some brainpower,"}, {"s": 27.84, "e": 28.64, "t": "because part of you"}, {"s": 28.68, "e": 29.6, "t": "is busy trying not"}, {"s": 29.64, "e": 30.2, "t": "to check it."}, {"s": 31.44, "e": 32.36, "t": "Plot twist!"}, {"s": 32.86, "e": 33.7, "t": "Ever felt your phone"}, {"s": 33.72, "e": 33.94, "t": "buzz,"}, {"s": 34.02, "e": 34.62, "t": "but it didn't?"}, {"s": 35.02, "e": 36.74, "t": "That's called phantom vibration."}, {"s": 37.02, "e": 37.78, "t": "In one study of"}, {"s": 37.8, "e": 38.64, "t": "hospital staff,"}, {"s": 38.84, "e": 39.52, "t": "most of them had"}, {"s": 39.56, "e": 39.96, "t": "felt it."}, {"s": 40.42, "e": 41.38, "t": "Your brain is so"}, {"s": 41.44, "e": 42.28, "t": "tuned to your phone,"}, {"s": 42.6, "e": 43.82, "t": "it starts imagining it."}, {"s": 44.3, "e": 45.16, "t": "Some people even feel"}, {"s": 45.2, "e": 45.86, "t": "it buzzing in a"}, {"s": 45.92, "e": 46.84, "t": "pocket where the phone"}, {"s": 46.9, "e": 47.26, "t": "isn't."}, {"s": 47.86, "e": 48.08, "t": "So,"}, {"s": 48.22, "e": 49.02, "t": "how many times did"}, {"s": 49.06, "e": 49.8, "t": "you check your phone"}, {"s": 49.82, "e": 50.18, "t": "today?"}, {"s": 50.58, "e": 51.18, "t": "Be honest,"}, {"s": 51.24, "e": 51.7, "t": "and tell me in"}, {"s": 51.74, "e": 52.38, "t": "the comments."}, {"s": 52.76, "e": 53.8, "t": "And subscribe for more"}, {"s": 53.84, "e": 54.44, "t": "HowCome!"}]