[{"s": 0.66, "e": 0.98, "t": "Gulp."}, {"s": 1.22, "e": 2.04, "t": "You just swallowed your"}, {"s": 2.18, "e": 2.58, "t": "gum."}, {"s": 2.8, "e": 3.74, "t": "Remember what they told"}, {"s": 3.8, "e": 3.92, "t": "you?"}, {"s": 4.1, "e": 4.8, "t": "It stays in your"}, {"s": 4.86, "e": 6.5, "t": "stomach for seven years."}, {"s": 6.6, "e": 7.12, "t": "But what if you"}, {"s": 7.18, "e": 8.66, "t": "swallowed gum every day?"}, {"s": 8.88, "e": 9.7, "t": "Is your stomach a"}, {"s": 9.74, "e": 10.46, "t": "gum museum?"}, {"s": 10.68, "e": 11.34, "t": "So the truth?"}, {"s": 11.52, "e": 12.44, "t": "A swallowed piece of"}, {"s": 12.48, "e": 13.5, "t": "gum usually leaves your"}, {"s": 13.52, "e": 14.16, "t": "body in a few"}, {"s": 14.18, "e": 14.56, "t": "days,"}, {"s": 14.68, "e": 15.82, "t": "not seven years."}, {"s": 15.98, "e": 17.16, "t": "Doctors only saw real"}, {"s": 17.2, "e": 18.54, "t": "trouble in rare cases,"}, {"s": 18.7, "e": 19.84, "t": "mostly kids who swallowed"}, {"s": 19.9, "e": 20.6, "t": "tons of gum,"}, {"s": 20.8, "e": 21.72, "t": "often with other things"}, {"s": 21.76, "e": 22.52, "t": "like coins."}, {"s": 22.7, "e": 23.72, "t": "So swallowing a piece"}, {"s": 23.76, "e": 24.58, "t": "now and then isn't"}, {"s": 24.62, "e": 25.22, "t": "a big deal,"}, {"s": 25.36, "e": 26.1, "t": "but gum is still"}, {"s": 26.14, "e": 26.899, "t": "made for chewing,"}, {"s": 26.979, "e": 27.66, "t": "not eating."}, {"s": 31.676, "e": 32.496, "t": "Plot twist!"}, {"s": 32.656, "e": 33.556, "t": "People have chewed gum"}, {"s": 33.596, "e": 34.916, "t": "for thousands of years."}, {"s": 35.076, "e": 36.036, "t": "Scientists found a piece"}, {"s": 36.096, "e": 37.276, "t": "of ancient chewed tree"}, {"s": 37.396, "e": 37.656, "t": "tar,"}, {"s": 37.816, "e": 39.176, "t": "about five thousand seven"}, {"s": 39.216, "e": 40.076, "t": "hundred years old,"}, {"s": 40.176, "e": 40.716, "t": "and they got the"}, {"s": 40.796, "e": 42.196, "t": "chewer's full DNA from"}, {"s": 42.256, "e": 42.436, "t": "it."}, {"s": 42.556, "e": 43.276, "t": "It even had bits"}, {"s": 43.316, "e": 44.436, "t": "of hazelnut and duck"}, {"s": 44.496, "e": 44.796, "t": "in it."}, {"s": 44.896, "e": 46.476, "t": "That's like a five-thousand-year-old"}, {"s": 46.496, "e": 47.256, "t": "dinner receipt."}, {"s": 47.476, "e": 47.716, "t": "So,"}, {"s": 47.876, "e": 48.656, "t": "do you swallow your"}, {"s": 48.676, "e": 49.396, "t": "gum or spit it"}, {"s": 49.496, "e": 49.676, "t": "out?"}, {"s": 49.836, "e": 50.256, "t": "Tell me in the"}, {"s": 50.296, "e": 50.716, "t": "comments,"}, {"s": 50.756, "e": 51.756, "t": "and subscribe for more"}, {"s": 51.796, "e": 52.376, "t": "HowCome!"}]