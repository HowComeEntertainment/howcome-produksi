[{"s": 0.1, "e": 1.3, "t": "You sit for breakfast,"}, {"s": 1.56, "e": 2.44, "t": "sit in the car,"}, {"s": 2.68, "e": 3.58, "t": "sit at your desk,"}, {"s": 3.74, "e": 4.4, "t": "then sit on the"}, {"s": 4.46, "e": 5.46, "t": "couch to scroll."}, {"s": 5.62, "e": 6.38, "t": "What happens if you"}, {"s": 6.5, "e": 7.28, "t": "sit all day,"}, {"s": 7.46, "e": 8.06, "t": "every day?"}, {"s": 8.401, "e": 9.521, "t": "Your leg muscles work"}, {"s": 9.56, "e": 10.7, "t": "like sugar sponges."}, {"s": 10.841, "e": 11.441, "t": "When they move,"}, {"s": 11.56, "e": 12.461, "t": "they pull sugar out"}, {"s": 12.501, "e": 13.101, "t": "of your blood."}, {"s": 13.281, "e": 14.04, "t": "Sit for hours,"}, {"s": 14.121, "e": 15.441, "t": "and those sponges basically"}, {"s": 15.481, "e": 16.181, "t": "fall asleep."}, {"s": 16.321, "e": 17.241, "t": "Your hips get tight,"}, {"s": 17.34, "e": 18.12, "t": "and your lower back"}, {"s": 18.221, "e": 19.001, "t": "starts complaining."}, {"s": 19.121, "e": 20.181, "t": "Here's the scary part."}, {"s": 20.401, "e": 21.441, "t": "After just three hours"}, {"s": 21.481, "e": 21.901, "t": "of sitting,"}, {"s": 22.061, "e": 23.501, "t": "scientists measured worse blood"}, {"s": 23.601, "e": 24.221, "t": "flow in the leg"}, {"s": 24.301, "e": 24.821, "t": "arteries."}, {"s": 24.941, "e": 25.981, "t": "But a five-minute walk"}, {"s": 26.061, "e": 27.081, "t": "every hour kept it"}, {"s": 27.141, "e": 27.561, "t": "normal."}, {"s": 33.028, "e": 33.748, "t": "Plot twist!"}, {"s": 33.948, "e": 34.828, "t": "Sitting is NOT the"}, {"s": 34.888, "e": 35.608, "t": "new smoking."}, {"s": 35.748, "e": 37.108, "t": "Smoking is way worse."}, {"s": 37.288, "e": 38.028, "t": "A study of over"}, {"s": 38.068, "e": 39.228, "t": "a million people found"}, {"s": 39.268, "e": 40.088, "t": "that about an hour"}, {"s": 40.128, "e": 41.068, "t": "of brisk walking a"}, {"s": 41.108, "e": 42.168, "t": "day seemed to cancel"}, {"s": 42.228, "e": 43.228, "t": "out th