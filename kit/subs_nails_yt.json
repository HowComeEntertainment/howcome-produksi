[{"s": 0.22, "e": 0.46, "t": "Snip,"}, {"s": 0.54, "e": 0.82, "t": "snip."}, {"s": 0.98, "e": 2.22, "t": "Everyone cuts their nails."}, {"s": 2.32, "e": 2.92, "t": "But what if you"}, {"s": 2.98, "e": 4.1, "t": "never cut them again?"}, {"s": 4.26, "e": 5.22, "t": "Not even once?"}, {"s": 5.42, "e": 6.32, "t": "Your fingers would look"}, {"s": 6.36, "e": 7.16, "t": "like claws."}, {"s": 18.328, "e": 19.628, "t": "Your fingernails grow about"}, {"s": 19.648, "e": 20.208, "t": "three and a half"}, {"s": 20.248, "e": 21.508, "t": "millimeters every month."}, {"s": 21.668, "e": 22.628, "t": "Toenails are slower,"}, {"s": 22.788, "e": 23.848, "t": "about half that speed."}, {"s": 23.948, "e": 24.728, "t": "It doesn't sound like"}, {"s": 24.788, "e": 25.028, "t": "much,"}, {"s": 25.188, "e": 25.908, "t": "until you add up"}, {"s": 25.948, "e": 26.588, "t": "the years."}, {"s": 26.688, "e": 27.608, "t": "They grow faster in"}, {"s": 27.648, "e": 27.968, "t": "summer,"}, {"s": 27.988, "e": 28.888, "t": "and faster when you're"}, {"s": 28.928, "e": 29.248, "t": "young."}, {"s": 29.368, "e": 29.888, "t": "And they're made of"}, {"s": 29.948, "e": 30.428, "t": "keratin,"}, {"s": 30.508, "e": 31.528, "t": "the same tough protein"}, {"s": 31.588, "e": 32.168, "t": "as your hair."}, {"s": 43.436, "e": 44.216, "t": "After one year,"}, {"s": 44.356, "e": 45.216, "t": "your fingernails would be"}, {"s": 45.296, "e": 46.956, "t": "around four centimeters longer."}, {"s": 47.116, "e": 48.096, "t": "Typing gets hard."}, {"s": 48.256, "e": 49.276, "t": "Buttons get tricky."}, {"s": 49.296, "e": 50.436, "t": "And under long nails,"}, {"s": 50.576, "e": 51.316, "t": "dirt and germs have"}, {"s": 51.356, "e": 52.216, "t": "a lot more places"}, {"s": 52.256, "e": 52.756, "t": "to hide."}, {"s": 52.976, "e": 54.155, "t": "So every handshake gets"}, {"s": 54.216, "e": 54.976, "t": "a little riskier."}, {"s": 55.176, "e": 56.376, "t": "Long toenails are even"}, {"s": 56.416, "e": 56.836, "t": "worse."}, {"s": 56.976, "e": 57.756, "t": "They press into your"}, {"s": 57.796, "e": 58.136, "t": "shoes,"}, {"s": 58.196, "e": 58.856, "t": "and can grow into"}, {"s": 58.896, "e": 59.396, "t": "the skin,"}, {"s": 59.496, "e": 60.476, "t": "which is painful and"}, {"s": 60.516, "e": 61.376, "t": "can get infected."}, {"s": 61.476, "e": 62.356, "t": "That's why doctors say"}, {"s": 62.396, "e": 63.496, "t": "to cut toenails straight"}, {"s": 63.536, "e": 64.036, "t": "across,"}, {"s": 64.216, "e": 64.936, "t": "not round."}, {"s": 76.064, "e": 77.044, "t": "Keep going for years,"}, {"s": 77.104, "e": 77.984, "t": "and nails don't just"}, {"s": 78.024, "e": 78.704, "t": "grow straight."}, {"s": 78.784, "e": 79.664, "t": "They start to curl"}, {"s": 79.704, "e": 80.364, "t": "and twist."}, {"s": 80.544, "e": 81.284, "t": "One woman grew her"}, {"s": 81.304, "e": 82.464, "t": "nails for almost thirty"}, {"s": 82.564, "e": 82.924, "t": "years,"}, {"s": 83.004, "e": 84.004, "t": "and together they reached"}, {"s": 84.064, "e": 85.144, "t": "over eight meters."}, {"s": 85.284, "e": 86.124, "t": "She couldn't do simple"}, {"s": 86.164, "e": 86.904, "t": "things like pick up"}, {"s": 86.944, "e": 87.464, "t": "a coin."}, {"s": 87.644, "e": 88.884, "t": "Super long nails also"}, {"s": 88.904, "e": 89.744, "t": "get weaker as they"}, {"s": 89.784, "e": 90.084, "t": "grow,"}, {"s": 90.224, "e": 91.004, "t": "so they can crack"}, {"s": 91.044, "e": 91.764, "t": "or break off,"}, {"s": 91.884, "e": 92.924, "t": "sometimes painfully."}, {"s": 104.052, "e": 104.872, "t": "Plot twist!"}, {"s": 104.992, "e": 106.132, "t": "You've probably heard nails"}, {"s": 106.172, "e": 107.311, "t": "keep growing after death."}, {"s": 107.472, "e": 107.992, "t": "They don't."}, {"s": 108.132, "e": 109.112, "t": "The skin just dries"}, {"s": 109.192, "e": 110.032, "t": "out and pulls back,"}, {"s": 110.112, "e": 111.212, "t": "so nails look longer."}, {"s": 111.312, "e": 112.152, "t": "And here's a bonus:"}, {"s": 112.292, "e": 113.012, "t": "the nails on your"}, {"s": 113.052, "e": 114.332, "t": "dominant hand often grow"}, {"s": 114.372, "e": 115.132, "t": "a bit faster."}, {"s": 115.292, "e": 116.252, "t": "Nails can also show"}, {"s": 116.292, "e": 117.212, "t": "hints about your health,"}, {"s": 117.372, "e": 118.612, "t": "like lines or spots,"}, {"s": 118.752, "e": 119.932, "t": "so doctors sometimes look"}, {"s": 119.972, "e": 120.332, "t": "at them."}, {"s": 131.54, "e": 132.24, "t": "So how often do"}, {"s": 132.28, "e": 133.14, "t": "you cut your nails?"}, {"s": 133.28, "e": 134.28, "t": "Team short nails or"}, {"s": 134.4, "e": 135.22, "t": "team long nails?"}, {"s": 135.34, "e": 135.78, "t": "Tell me in the"}, {"s": 135.82, "e": 136.24, "t": "comments,"}, {"s": 136.3, "e": 137.3, "t": "and subscribe for more"}, {"s": 137.34, "e": 137.94, "t": "HowCome!"}]