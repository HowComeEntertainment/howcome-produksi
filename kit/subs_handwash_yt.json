[{"s": 0.64, "e": 1.62, "t": "You leave the bathroom,"}, {"s": 1.86, "e": 2.76, "t": "and you didn't wash"}, {"s": 2.8, "e": 3.34, "t": "your hands."}, {"s": 3.68, "e": 4.6, "t": "What if you never"}, {"s": 4.66, "e": 5.94, "t": "washed your hands after"}, {"s": 5.98, "e": 6.86, "t": "the toilet again?"}, {"s": 7.24, "e": 7.9, "t": "Be honest."}, {"s": 19.352, "e": 20.072, "t": "You're not alone."}, {"s": 20.292, "e": 20.952, "t": "In one study,"}, {"s": 21.092, "e": 22.792, "t": "researchers secretly watched people"}, {"s": 22.812, "e": 23.792, "t": "in public bathrooms."}, {"s": 23.952, "e": 25.152, "t": "Only about five percent"}, {"s": 25.192, "e": 26.152, "t": "washed long enough to"}, {"s": 26.172, "e": 27.151, "t": "really kill germs."}, {"s": 27.291, "e": 28.132, "t": "And around one in"}, {"s": 28.192, "e": 29.172, "t": "ten didn't wash at"}, {"s": 29.272, "e": 29.512, "t": "all."}, {"s": 29.752, "e": 30.612, "t": "About a third didn't"}, {"s": 30.672, "e": 31.232, "t": "use soap."}, {"s": 31.372, "e": 32.232, "t": "And many people think"}, {"s": 32.272, "e": 33.092, "t": "a quick rinse with"}, {"s": 33.132, "e": 34.092, "t": "water is enough."}, {"s": 34.352, "e": 34.952, "t": "It's not."}, {"s": 46.404, "e": 47.404, "t": "Germs from the bathroom"}, {"s": 47.464, "e": 48.284, "t": "ride on your hands"}, {"s": 48.324, "e": 49.424, "t": "to everything you touch."}, {"s": 49.664, "e": 50.424, "t": "Door handles,"}, {"s": 50.524, "e": 51.064, "t": "your phone,"}, {"s": 51.304, "e": 51.724, "t": "snacks,"}, {"s": 51.844, "e": 52.444, "t": "your face."}, {"s": 52.984, "e": 53.724, "t": "Some of those germs"}, {"s": 53.764, "e": 54.784, "t": "can cause stomach bugs"}, {"s": 54.803, "e": 55.484, "t": "and diarrhea,"}, {"s": 55.644, "e": 56.444, "t": "and they spread from"}, {"s": 56.504, "e": 57.464, "t": "person to person."}, {"s": 57.624, "e": 58.384, "t": "And it's not just"}, {"s": 58.484, "e": 58.684, "t": "you."}, {"s": 58.884, "e": 59.424, "t": "If you cook,"}, {"s": 59.564, "e": 60.104, "t": "shake hands,"}, {"s": 60.184, "e": 61.344, "t": "or touch shared things,"}, {"s": 61.524, "e": 62.464, "t": "you pass those germs"}, {"s": 62.504, "e": 63.384, "t": "to other people too."}, {"s": 63.564, "e": 64.684, "t": "That's how one person's"}, {"s": 64.724, "e": 65.864, "t": "unwashed hands can make"}, {"s": 65.924, "e": 67.244, "t": "a whole office sick."}, {"s": 78.656, "e": 79.276, "t": "The good news?"}, {"s": 79.556, "e": 80.976, "t": "Simple handwashing with soap"}, {"s": 81.016, "e": 82.296, "t": "makes a huge difference."}, {"s": 82.576, "e": 83.416, "t": "Studies show it can"}, {"s": 83.456, "e": 84.776, "t": "cut diarrhea illnesses by"}, {"s": 84.856, "e": 85.656, "t": "about a quarter to"}, {"s": 85.716, "e": 86.196, "t": "a third."}, {"s": 86.396, "e": 86.936, "t": "Just soap,"}, {"s": 87.176, "e": 87.456, "t": "water,"}, {"s": 87.576, "e": 88.736, "t": "and about twenty seconds."}, {"s": 88.956, "e": 89.876, "t": "Soap works because it"}, {"s": 89.896, "e": 91.036, "t": "breaks apart the oily"}, {"s": 91.096, "e": 92.096, "t": "layer that helps germs"}, {"s": 92.156, "e": 93.036, "t": "stick to your skin."}, {"s": 93.196, "e": 94.096, "t": "Then the water rinses"}, {"s": 94.136, "e": 94.696, "t": "them away."}, {"s": 106.148, "e": 106.928, "t": "Plot twist!"}, {"s": 107.128, "e": 107.808, "t": "How you dry your"}, {"s": 107.848, "e": 108.868, "t": "hands matters too."}, {"s": 109.068, "e": 109.968, "t": "One study found that"}, {"s": 110.028, "e": 111.468, "t": "powerful jet air dryers"}, {"s": 111.508, "e": 112.748, "t": "blew bacteria around the"}, {"s": 112.788, "e": 113.928, "t": "bathroom much more than"}, {"s": 113.968, "e": 114.768, "t": "paper towels."}, {"s": 114.968, "e": 115.828, "t": "So grab a towel"}, {"s": 115.908, "e": 116.468, "t": "if you can."}, {"s": 116.628, "e": 117.608, "t": "Hot water doesn't kill"}, {"s": 117.688, "e": 118.228, "t": "more germs,"}, {"s": 118.308, "e": 118.808, "t": "by the way."}, {"s": 119.008, "e": 120.428, "t": "Any comfortable temperature works"}, {"s": 120.488, "e": 121.188, "t": "if you use soap"}, {"s": 121.208, "e": 121.808, "t": "and scrub."}, {"s": 133.32, "e": 133.82, "t": "Be honest."}, {"s": 133.94, "e": 134.64, "t": "Do you always wash"}, {"s": 134.68, "e": 135.14, "t": "your hands?"}, {"s": 135.38, "e": 135.8, "t": "Tell me in the"}, {"s": 135.84, "e": 136.28, "t": "comments,"}, {"s": 136.36, "e": 137.32, "t": "and subscribe for more"}, {"s": 137.36, "e": 137.92, "t": "HowCome!"}]