[{"s": 0.14, "e": 0.66, "t": "Bzzz."}, {"s": 0.98, "e": 1.88, "t": "You grab your phone."}, {"s": 2.6, "e": 3.0, "t": "Nothing."}, {"s": 3.82, "e": 4.6, "t": "Five minutes later,"}, {"s": 5.0, "e": 5.46, "t": "again."}, {"s": 6.18, "e": 6.88, "t": "What if you checked"}, {"s": 6.92, "e": 8.34, "t": "your phone every five"}, {"s": 8.44, "e": 8.82, "t": "minutes,"}, {"s": 9.26, "e": 10.1, "t": "all day long?"}, {"s": 11.52, "e": 12.18, "t": "Sound familiar?"}, {"s": 21.148, "e": 21.488, "t": "Honestly,"}, {"s": 21.588, "e": 22.428, "t": "that's not far from"}, {"s": 22.488, "e": 22.848, "t": "normal."}, {"s": 23.428, "e": 24.428, "t": "One big survey found"}, {"s": 24.468, "e": 25.688, "t": "Americans check their phones"}, {"s": 25.728, "e": 27.248, "t": "about ninety-six times a"}, {"s": 27.388, "e": 27.688, "t": "day."}, {"s": 28.128, "e": 29.108, "t": "That's roughly once every"}, {"s": 29.148, "e": 30.148, "t": "ten minutes you're awake."}, {"s": 30.668, "e": 31.308, "t": "And most of the"}, {"s": 31.348, "e": 31.588, "t": "time,"}, {"s": 31.988, "e": 32.828, "t": "you don't even remember"}, {"s": 32.868, "e": 33.268, "t": "doing it."}, {"s": 33.888, "e": 34.908, "t": "Some people check way"}, {"s": 34.968, "e": 35.508, "t": "more than that,"}, {"s": 35.768, "e": 36.788, "t": "especially teens."}, {"s": 45.777, "e": 46.876, "t": "Every check pulls your"}, {"s": 46.916, "e": 47.556, "t": "focus away."}, {"s": 47.936, "e": 48.776, "t": "And getting back into"}, {"s": 48.816, "e": 50.436, "t": "deep focus isn't instant."}, {"s": 50.896, "e": 52.316, "t": "Researchers who study work"}, {"s": 52.356, "e": 53.476, "t": "interruptions found it can"}, {"s": 53.516, "e": 54.476, "t": "take a long time"}, {"s": 54.496, "e": 55.316, "t": "to fully get back"}, {"s": 55.356, "e": 55.896, "t": "on track."}, {"s": 56.336, "e": 57.016, "t": "So a day full"}, {"s": 57.056, "e": 58.256, "t": "of tiny checks becomes"}, {"s": 58.296, "e": 59.256, "t": "a day without real"}, {"s": 59.296, "e": 59.816, "t": "focus."}, {"s": 60.436, "e": 61.636, "t": "Every buzz also gives"}, {"s": 61.676, "e": 62.616, "t": "your brain a tiny"}, {"s": 62.796, "e": 63.896, "t": "jolt of something new,"}, {"s": 64.336, "e": 65.316, "t": "which is exactly why"}, {"s": 65.356, "e": 66.016, "t": "it's so hard to"}, {"s": 66.056, "e": 66.536, "t": "ignore."}, {"s": 66.976, "e": 67.916, "t": "And checking in bed?"}, {"s": 68.276, "e": 69.356, "t": "The bright screen keeps"}, {"s": 69.396, "e": 70.336, "t": "your brain alert and"}, {"s": 70.396, "e": 71.176, "t": "can push your sleep"}, {"s": 71.236, "e": 71.576, "t": "later."}, {"s": 80.424, "e": 81.424, "t": "Here's the wild part."}, {"s": 81.644, "e": 82.524, "t": "In one experiment,"}, {"s": 82.844, "e": 84.104, "t": "people did harder thinking"}, {"s": 84.204, "e": 85.504, "t": "tests just because their"}, {"s": 85.524, "e": 86.264, "t": "phone was sitting on"}, {"s": 86.304, "e": 86.864, "t": "the desk."}, {"s": 87.244, "e": 87.764, "t": "Turned off,"}, {"s": 87.984, "e": 88.584, "t": "face down,"}, {"s": 88.804, "e": 89.383, "t": "didn't matter."}, {"s": 89.823, "e": 90.844, "t": "Phone in another room?"}, {"s": 91.184, "e": 92.004, "t": "They scored better."}, {"s": 92.544, "e": 93.664, "t": "Just having it nearby"}, {"s": 93.704, "e": 94.364, "t": "seems to use up"}, {"s": 94.404, "e": 95.184, "t": "some brainpower,"}, {"s": 95.464, "e": 96.264, "t": "because part of you"}, {"s": 96.304, "e": 97.224, "t": "is busy trying not"}, {"s": 97.264, "e": 97.824, "t": "to check it."}, {"s": 106.632, "e": 107.552, "t": "Plot twist!"}, {"s": 108.052, "e": 108.892, "t": "Ever felt your phone"}, {"s": 108.912, "e": 109.132, "t": "buzz,"}, {"s": 109.212, "e": 109.812, "t": "but it didn't?"}, {"s": 110.212, "e": 111.932, "t": "That's called phantom vibration."}, {"s": 112.212, "e": 112.972, "t": "In one study of"}, {"s": 112.992, "e": 113.832, "t": "hospital staff,"}, {"s": 114.032, "e": 114.712, "t": "most of them had"}, {"s": 114.752, "e": 115.152, "t": "felt it."}, {"s": 115.612, "e": 116.572, "t": "Your brain is so"}, {"s": 116.632, "e": 117.472, "t": "tuned to your phone,"}, {"s": 117.792, "e": 119.012, "t": "it starts imagining it."}, {"s": 119.492, "e": 120.352, "t": "Some people even feel"}, {"s": 120.392, "e": 121.052, "t": "it buzzing in a"}, {"s": 121.112, "e": 122.032, "t": "pocket where the phone"}, {"s": 122.092, "e": 122.452, "t": "isn't."}, {"s": 131.34, "e": 131.56, "t": "So,"}, {"s": 131.7, "e": 132.5, "t": "how many times did"}, {"s": 132.54, "e": 133.28, "t": "you check your phone"}, {"s": 133.3, "e": 133.66, "t": "today?"}, {"s": 134.06, "e": 134.66, "t": "Be honest,"}, {"s": 134.72, "e": 135.18, "t": "and tell me in"}, {"s": 135.22, "e": 135.86, "t": "the comments."}, {"s": 136.24, "e": 137.28, "t": "And subscribe for more"}, {"s": 137.32, "e": 137.92, "t": "HowCome!"}]